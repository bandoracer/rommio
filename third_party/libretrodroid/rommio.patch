+std::pair<int8_t*, size_t> LibretroDroid::serializeMemory(unsigned id) {
+    std::lock_guard<std::mutex> lock(coreLock);
+
+    if (!core || !gameLoaded) throw LibretroDroidError("Core is not ready", ERROR_SERIALIZATION);
+    if (!persistentMemoryId(id))
+        throw LibretroDroidError("Unsupported persistent memory region", ERROR_SERIALIZATION);
+    const size_t size = core->retro_get_memory_size(id);
+    if (size > 256u * 1024u * 1024u) throw LibretroDroidError("Unsupported memory size", ERROR_SERIALIZATION);
+    auto source = core->retro_get_memory_data(id);
+    if (size > 0 && source == nullptr) throw LibretroDroidError("Missing memory buffer", ERROR_SERIALIZATION);
+    auto data = std::make_unique<int8_t[]>(size);
+    if (size > 0) memcpy(data.get(), source, size);
+    return std::pair(data.release(), size);
 }
 
