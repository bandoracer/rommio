+
+bool LibretroDroid::unserializeMemoryRegions(const std::vector<MemoryRegion>& regions) {
+    std::lock_guard<std::mutex> lock(coreLock);
+    if (!core || !gameLoaded || regions.empty() || regions.size() > 5) return false;
+    std::unordered_set<unsigned> ids;
+    size_t total = 0;
+    bool extended = false;
+    // Validate every ID before querying a core. Duplicate regions cannot alias a write.
+    for (const auto& region : regions) {
+        if (!persistentMemoryId(region.id) || !ids.insert(region.id).second ||
+            region.size > 256u * 1024u * 1024u) return false;
+        extended = extended || region.id >= 0x100;
+        total += region.size;
+        if (total > 256u * 1024u * 1024u) return false;
+    }
+    if (extended && core->retro_rommio_memory_restored == nullptr) return false;
+    if (core->retro_rommio_prepare_restore) {
+        if (regions.size() != 2 || ids.count(0) != 1 || ids.count(1) != 1) return false;
+        for (const auto& region : regions) {
+            if (region.id == 1 && region.size != 0) return false;
+            if (region.id == 0 && (region.size < 12 || region.size > 64u * 1024u * 1024u ||
+                                   !core->retro_rommio_prepare_restore(region.size))) return false;
+        }
+    }
+    std::vector<void*> destinations;
+    for (const auto& region : regions) {
+        if (region.size != core->retro_get_memory_size(region.id)) return false;
+        void* destination = core->retro_get_memory_data(region.id);
+        if (region.size > 0 && (region.data == nullptr || destination == nullptr)) return false;
+        destinations.push_back(destination);
+    }
+    // All destinations and sizes are checked before any copy, including extra battery banks.
+    for (size_t i = 0; i < regions.size(); ++i) {
+        if (regions[i].size > 0) memcpy(destinations[i], regions[i].data, regions[i].size);
+    }
+    return core->retro_rommio_memory_restored == nullptr || core->retro_rommio_memory_restored();
+}
+
+std::optional<std::string> LibretroDroid::getPersistenceDescriptor() {
+    std::lock_guard<std::mutex> lock(coreLock);
+    if (!core || !gameLoaded) throw LibretroDroidError("Core is not ready", ERROR_SERIALIZATION);
+    if (core->retro_rommio_persistence_descriptor == nullptr) return std::nullopt;
+    const char* descriptor = core->retro_rommio_persistence_descriptor();
+    if (descriptor == nullptr) return std::nullopt;
+    const size_t length = strnlen(descriptor, 129);
+    if (length == 0 || length > 128) throw LibretroDroidError("Invalid persistence descriptor", ERROR_SERIALIZATION);
+    for (size_t i = 0; i < length; ++i) {
+        if (descriptor[i] < 32 || descriptor[i] > 126) throw LibretroDroidError("Non-ASCII persistence descriptor", ERROR_SERIALIZATION);
+    }
+    return std::string(descriptor, length);
+}
