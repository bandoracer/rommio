+/* Optional Rommio descriptor: report the effective board after database/header
+ * correction. Comparing GameInterface prevents stale iNES metadata from
+ * describing UNIF/FDS/NSF content loaded later in the same core instance. */
+const char *retro_rommio_persistence_descriptor(void) {
+    static char descriptor[96];
+    if (!GameInfo || GameInfo->type != GIT_CART || GameInterface != iNESGI)
+        return NULL;
+    snprintf(descriptor, sizeof(descriptor), "fceumm-ines-v1:%d:%d:%d:%d:%d:%d",
+        iNESCart.iNES2 ? 2 : 1, iNESCart.mapper, iNESCart.submapper, iNESCart.battery ? 1 : 0,
+        iNESCart.PRGRamSaveSize, iNESCart.CHRRamSaveSize);
+    return descriptor;
 }
 
