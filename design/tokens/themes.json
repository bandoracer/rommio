  "colorRoles": {
    "ground": "Page background.",
    "groundRaised": "Grouped/secondary background (settings lists, sheets).",
    "surface": "Card surface. Aurora: translucent glass over the page light. Riso: paper card.",
    "surfaceStrong": "Pressed/selected card surface, search field, segmented control track.",
    "ink": "Primary text and icons.",
    "inkSecondary": "Secondary text.",
    "inkTertiary": "Tertiary text, placeholders, disabled.",
    "hairline": "Dividers and 0.5-1 pt strokes.",
    "keyline": "Strong rules (Riso section rules, outlines). Aurora uses a hairline.",
    "tint": "Accent for links, selection, toggles and the system tint.",
    "buttonFill": "Primary button fill.",
    "buttonInk": "Primary button text.",
    "ok": "Synced / success.",
    "wait": "Waiting / pending upload.",
    "live": "Syncing / in progress.",
    "bad": "Error / conflict.",
    "badText": "Error and destructive text (4.5:1 on ground). Use instead of `bad` whenever the colour carries text.",
    "accent1": "Aurora: fallback light 1 when a page has no art. Riso: pink plate.",
    "accent2": "Aurora: fallback light 2. Riso: blue plate.",
    "accent3": "Aurora: fallback light 3. Riso: yellow.",
    "accent4": "Riso green; Aurora: ok.",
    "onAccent": "Text on accent fills.",
    "scrim": "Dimming behind sheets and over art."
  },
