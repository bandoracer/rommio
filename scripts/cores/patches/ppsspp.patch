 #include <fcntl.h>
 #endif
 
+static std::vector<DirectoryFileSystem*> rommio_directories;
+bool DirectoryFileSystem::RommioFlushAll() {
+    for (auto *fs : rommio_directories) for (auto &item : fs->entries) {
+        auto &file = item.second.hFile;
+#ifdef HAVE_LIBRETRO_VFS
+        if (!file.hFile) return false;
+        if (file.needsTrunc_ >= 0) {
+            if (filestream_truncate(file.hFile, file.needsTrunc_) != 0) return false;
+            file.needsTrunc_ = -1;
+        }
+        if (fflush(file.hFile) != 0) return false;
+#else
+        return false;
+#endif
+    }
+    return true;
+}
+void DirectoryFileSystem::RommioCloseAll() { for (auto *fs : rommio_directories) fs->CloseAll(); }
+
 DirectoryFileSystem::DirectoryFileSystem(IHandleAllocator *_hAlloc, const Path & _basePath, FileSystemFlags _flags) : basePath(_basePath), flags(_flags) {
+    rommio_directories.push_back(this);
 	File::CreateFullPath(basePath);
 
 	static const std::string_view mixedCase = "wJpCzSBNnZfxSgoS";
@@ -90,6 +110,7 @@ DirectoryFileSystem::DirectoryFileSystem(IHandleAllocator *_hAlloc, const Path &
 }
 
 DirectoryFileSystem::~DirectoryFileSystem() {
+    rommio_directories.erase(std::remove(rommio_directories.begin(), rommio_directories.end(), this), rommio_directories.end());
 	CloseAll();
