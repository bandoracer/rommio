+extern "C" RETRO_API const char *retro_rommio_persistence_descriptor() {
+    static char result[128];
+    if (!rom_loaded) return "";
+    switch (rommioCartType) {
+      case 0: case 1: case 2: case 3: case 5: case 6: case 15: case 16: case 17: case 18: case 19:
+      case 25: case 26: case 27: case 28: case 29: case 30: break;
+      default: return ""; // HuC3, MBC7 EEPROM, camera and special boards need separate audits.
+    }
+    snprintf(result,sizeof(result),"rommio-cart-v1:gambatte:gb:%u:%u",gb.savedata_size(),gb.rtcdata_size());
+    return result;
+}
+extern "C" RETRO_API bool retro_rommio_memory_restored() {
+    if (!rom_loaded) return false;
+    if (gb.rtcdata_size()==24) rommio_gambatte_restore_rtc();
+    return true;
+}
