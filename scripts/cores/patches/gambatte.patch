+// Fixed little-endian wire format; never persist native struct padding or time_t.
+static gambatte::Rtc *rommioRtc = 0;
+void *gambatte::Rtc::rommioData() {
+    rommioRtc = this;
+    for (unsigned i=0;i<8;++i) { rommioBytes_[i] = baseTime_ >> (8*i); rommioBytes_[8+i] = haltTime_ >> (8*i); }
+    rommioBytes_[16]=dataDh_; rommioBytes_[17]=dataDl_; rommioBytes_[18]=dataH_;
+    rommioBytes_[19]=dataM_; rommioBytes_[20]=dataS_; rommioBytes_[21]=lastLatchData_;
+    rommioBytes_[22]=0; rommioBytes_[23]=0;
+    return rommioBytes_;
+}
+void gambatte::Rtc::rommioRestore() {
+    baseTime_=0; haltTime_=0;
+    for (unsigned i=0;i<8;++i) { baseTime_ |= uint64_t(rommioBytes_[i]) << (8*i); haltTime_ |= uint64_t(rommioBytes_[8+i]) << (8*i); }
+    dataDh_=rommioBytes_[16]; dataDl_=rommioBytes_[17]; dataH_=rommioBytes_[18];
+    dataM_=rommioBytes_[19]; dataS_=rommioBytes_[20]; lastLatchData_=rommioBytes_[21];
+    doSwapActive();
+}
+extern "C" void rommio_gambatte_restore_rtc() { if (rommioRtc) rommioRtc->rommioRestore(); }
