diff --git a/src/tests/core/hle/service/mvd/h264_decoder.cpp b/src/tests/core/hle/service/mvd/h264_decoder.cpp
new file mode 100644
index 0000000..9d9e31a
--- /dev/null
+++ b/src/tests/core/hle/service/mvd/h264_decoder.cpp
@@ -0,0 +1,116 @@
+// Copyright 2026 Azahar Emulator Project
+// Licensed under GPLv2 or any later version
+// Refer to the license.txt file included.
+
+#include <array>
+#include <vector>
+#include <catch2/catch_test_macros.hpp>
+#include "core/hle/service/mvd/h264_decoder.h"
+#include "tests/core/hle/service/mvd/test_stream.h"
+
+using namespace Service::MVD;
+
+TEST_CASE("MVD H.264 NAL unit helpers", "[service][mvd]") {
+    const std::array<u8, 6> four_byte{0x00, 0x00, 0x00, 0x01, 0x65, 0x88};
+    const std::array<u8, 5> three_byte{0x00, 0x00, 0x01, 0x41, 0x9A};
+    REQUIRE(StripStartCode(four_byte).size() == 2);
+    REQUIRE(StripStartCode(three_byte).size() == 2);
+    REQUIRE(GetNalUnitType(StripStartCode(four_byte)) == NalUnitType::IdrSlice);
+    REQUIRE(GetNalUnitType(StripStartCode(three_byte)) == NalUnitType::Slice);
+    REQUIRE(GetNalRefIdc(StripStartCode(four_byte)) == 3);
+    REQUIRE(GetNalRefIdc(std::array<u8, 1>{0x01}) == 0);
+
+    // first_mb_in_slice is ue(v): "1" is 0, "00110" is 5.
+    const std::array<u8, 2> first_mb_zero{0x65, 0x80};
+    const std::array<u8, 2> first_mb_five{0x41, 0x30};
+    REQUIRE(GetFirstMbInSlice(first_mb_zero) == 0u);
+    REQUIRE(GetFirstMbInSlice(first_mb_five) == 5u);
+
+    // 23 zero bits, a one and 23 more zero bits (2^23 - 1) need two emulation prevention bytes.
+    const std::array<u8, 9> escaped{0x41, 0x00, 0x00, 0x03, 0x01, 0x00, 0x00, 0x03, 0x00};
+    REQUIRE(GetFirstMbInSlice(escaped) == (1u << 23) - 1);
+
+    const std::array<u8, 2> sps{0x67, 0x42};
+    REQUIRE(GetFirstMbInSlice(sps) == std::nullopt);
+    REQUIRE(GetFirstMbInSlice(std::span<const u8>{}) == std::nullopt);
+}
+
+TEST_CASE("MVD H.264 sequence parameter sets", "[service][mvd]") {
+    const auto units = MvdTest::SplitAnnexB(MvdTest::stream);
+    const auto info = ParseSequenceParameterSet(StripStartCode(units[0]));
+    REQUIRE(info);
+    REQUIRE(info->coded_width == MvdTest::width);
+    REQUIRE(info->coded_height == MvdTest::height);
+    REQUIRE(info->crop_left == 0);
+    REQUIRE(info->crop_width == MvdTest::width);
+    REQUIRE(info->crop_height == MvdTest::height);
+    REQUIRE_FALSE(info->monochrome);
+    REQUIRE_FALSE(info->interlaced);
+    REQUIRE_FALSE(ParseSequenceParameterSet(StripStartCode(units[1])));
+
+    // The SPS of an 854x480 Baseline stream from x264 (`ffmpeg -f lavfi -i
+    // testsrc2=size=854x480 -c:v libx264 -profile:v baseline`): coded as 864x480 with 10
+    // columns cropped on the right.
+    const std::array<u8, 25> cropped{0x67, 0x42, 0xC0, 0x1F, 0xD9, 0x00, 0xD8, 0x3D, 0xE6,
+                                     0xF0, 0x11, 0x00, 0x00, 0x03, 0x00, 0x01, 0x00, 0x00,
+                                     0x03, 0x00, 0x3C, 0x0F, 0x18, 0x32, 0x48};
+    const auto wide = ParseSequenceParameterSet(cropped);
+    REQUIRE(wide);
+    REQUIRE(wide->coded_width == 864);
+    REQUIRE(wide->coded_height == 480);
+    REQUIRE(wide->crop_left == 0);
+    REQUIRE(wide->crop_width == 854);
+    REQUIRE(wide->crop_height == 480);
+}
+
+TEST_CASE("MVD H.264 decoder reproduces a Baseline stream exactly", "[service][mvd]") {
+    auto decoder = CreateH264Decoder();
+    if (!decoder) {
+        SKIP("No H.264 decoder on this platform");
+    }
+    std::vector<DecodedPicture> pictures;
+    for (const auto unit : MvdTest::SplitAnnexB(MvdTest::stream)) {
+        const auto nal_unit = StripStartCode(unit);
+        const auto before = pictures.size();
+        for (auto& picture : decoder->Decode(nal_unit)) {
+            pictures.push_back(std::move(picture));
+        }
+        // A single-slice picture comes out with its slice, as the hardware reports it.
+        const auto type = GetNalUnitType(nal_unit);
+        const bool slice = type == NalUnitType::Slice || type == NalUnitType::IdrSlice;
+        REQUIRE(pictures.size() == before + (slice ? 1 : 0));
+    }
+    REQUIRE(decoder->Flush().empty());
+    REQUIRE(pictures.size() == MvdTest::expected_pictures.size());
+    for (std::size_t i = 0; i < pictures.size(); ++i) {
+        REQUIRE(pictures[i].width == MvdTest::width);
+        REQUIRE(pictures[i].height == MvdTest::height);
+        REQUIRE(MvdTest::Fnv1a(pictures[i].luma, pictures[i].chroma) ==
+                MvdTest::expected_pictures[i]);
+    }
+}
+
+TEST_CASE("MVD H.264 decoder restarts cleanly after a reset", "[service][mvd]") {
+    auto decoder = CreateH264Decoder();
+    if (!decoder) {
+        SKIP("No H.264 decoder on this platform");
+    }
+    const auto units = MvdTest::SplitAnnexB(MvdTest::stream);
+    for (const auto unit : units) {
+        decoder->Decode(StripStartCode(unit));
+    }
+    decoder->Reset();
+
+    // Without parameter sets a slice can't be decoded.
+    REQUIRE(decoder->Decode(StripStartCode(units[3])).empty());
+
+    std::vector<DecodedPicture> pictures;
+    for (const auto unit : units) {
+        for (auto& picture : decoder->Decode(StripStartCode(unit))) {
+            pictures.push_back(std::move(picture));
+        }
+    }
+    REQUIRE(pictures.size() == MvdTest::expected_pictures.size());
+    REQUIRE(MvdTest::Fnv1a(pictures.back().luma, pictures.back().chroma) ==
+            MvdTest::expected_pictures.back());
+}
