+/// The stream's NAL units, each with its start code.
+inline std::vector<std::span<const u8>> SplitAnnexB(std::span<const u8> data) {
+    std::vector<std::size_t> starts;
+    for (std::size_t i = 0; i + 3 <= data.size(); ++i) {
+        if (data[i] == 0 && data[i + 1] == 0 && data[i + 2] == 1) {
+            starts.push_back(i);
+        }
+    }
+    std::vector<std::span<const u8>> units;
+    for (std::size_t i = 0; i < starts.size(); ++i) {
+        std::size_t end = i + 1 < starts.size() ? starts[i + 1] : data.size();
+        // A four-byte start code's leading zero belongs to it, not to the previous unit.
+        if (i + 1 < starts.size() && data[end - 1] == 0) {
+            --end;
+        }
+        units.push_back(data.subspan(starts[i], end - starts[i]));
+    }
+    return units;
+}
+
+inline u64 Fnv1a(std::span<const u8> luma, std::span<const u8> chroma) {
+    u64 hash = 0xCBF29CE484222325ULL;
+    for (const auto plane : {luma, chroma}) {
+        for (const u8 byte : plane) {
+            hash = (hash ^ byte) * 0x100000001B3ULL;
+        }
+    }
+    return hash;
+}
+
+} // namespace MvdTest
