+/// A solid-color NV12 picture.
+struct SolidPicture {
+    SolidPicture(u32 width, u32 height, u8 y, u8 cb, u8 cr)
+        : luma(std::size_t{width} * height, y), chroma(std::size_t{width} * (height / 2)) {
+        for (std::size_t i = 0; i < chroma.size(); i += 2) {
+            chroma[i] = cb;
+            chroma[i + 1] = cr;
+        }
+        image = {.width = width,
+                 .height = height,
+                 .luma = luma,
+                 .luma_stride = width,
+                 .chroma = chroma,
+                 .chroma_stride = width};
+    }
+    std::vector<u8> luma;
+    std::vector<u8> chroma;
+    SourceImage image;
+};
+
+/// A picture whose luma encodes each pixel's position: Y = 16 + x + 2 * y (for small sizes).
+struct GradientPicture {
+    GradientPicture(u32 width, u32 height)
+        : luma(std::size_t{width} * height), chroma(std::size_t{width} * (height / 2), 128) {
+        for (u32 y = 0; y < height; ++y) {
+            for (u32 x = 0; x < width; ++x) {
+                luma[std::size_t{y} * width + x] = static_cast<u8>(16 + x + 2 * y);
+            }
+        }
+        image = {.width = width,
+                 .height = height,
+                 .luma = luma,
+                 .luma_stride = width,
+                 .chroma = chroma,
+                 .chroma_stride = width};
+    }
+    u8 At(u32 x, u32 y) const {
+        return luma[std::size_t{y} * image.width + x];
+    }
+    std::vector<u8> luma;
+    std::vector<u8> chroma;
+    SourceImage image;
+};
+
+PostprocessorConfig VideoConfig(u32 width, u32 height, PixelFormat output) {
+    PostprocessorConfig config{};
+    config.input_format = PixelFormat::YCbCr420Semiplanar;
+    config.input_width = width;
+    config.input_height = height;
+    config.output_format = output;
+    config.output_width = width;
+    config.output_height = height;
+    config.output_paddr = 0x20000000;
+    config.output_chroma_paddr = 0x20100000;
+    config.rgb_transform = 1; // BT.601
+    return config;
+}
+
+std::vector<u8> Run(const SourceImage& source, const PostprocessorConfig& config,
+                    std::vector<u8>* chroma = nullptr, u8 fill = 0) {
+    const auto layout = GetOutputLayout(config);
+    std::vector<u8> plane(layout.plane_size, fill);
+    std::vector<u8> chroma_plane(layout.chroma_size, fill);
+    Postprocess(source, config, {plane, chroma_plane});
+    if (chroma) {
+        *chroma = std::move(chroma_plane);
+    }
+    return plane;
+}
+
+u16 Read16(const std::vector<u8>& plane, std::size_t pixel) {
+    return static_cast<u16>(plane[pixel * 2] | plane[pixel * 2 + 1] << 8);
+}
+
+} // namespace
+
+TEST_CASE("MVD postprocessor converts BT.601 colors into each RGB layout", "[service][mvd]") {
+    // Limited-range BT.601 white, black and red.
+    const SolidPicture white(16, 16, 235, 128, 128);
+    const SolidPicture black(16, 16, 16, 128, 128);
+    const SolidPicture red(16, 16, 81, 90, 240);
+
+    const auto rgb565 = VideoConfig(16, 16, PixelFormat::Rgb16_565);
+    REQUIRE(Read16(Run(white.image, rgb565), 0) == 0xFFFF);
+    REQUIRE(Read16(Run(black.image, rgb565), 0) == 0x0000);
+    // 0x00040002 is the GPU's RGB565: red in bits 15..11 (libctru names it MVD_OUTPUT_BGR565).
+    REQUIRE(Read16(Run(red.image, rgb565), 0) == 0xF800);
+    REQUIRE(Read16(Run(red.image, VideoConfig(16, 16, PixelFormat::Bgr16_565)), 0) == 0x001F);
+
+    auto rgb555 = VideoConfig(16, 16, PixelFormat::Rgb16_555);
+    rgb555.transparency = 1;
+    REQUIRE(Read16(Run(red.image, rgb555), 0) == 0xFC00);
+
+    // 32-bit RGB words are stored alpha first.
+    auto bgr32 = VideoConfig(16, 16, PixelFormat::Bgr32);
+    bgr32.alpha = 0xAB;
+    const auto bgr = Run(red.image, bgr32);
+    REQUIRE(std::vector<u8>(bgr.begin(), bgr.begin() + 4) == std::vector<u8>{0xAB, 0, 0, 0xFF});
+    auto rgb32 = VideoConfig(16, 16, PixelFormat::Rgb32);
+    rgb32.alpha = 0xAB;
+    const auto rgb = Run(red.image, rgb32);
+    REQUIRE(std::vector<u8>(rgb.begin(), rgb.begin() + 4) == std::vector<u8>{0xAB, 0xFF, 0, 0});
+
+    // Full-range input uses the full-range coefficients: Y 255 is white, Y 0 is black.
+    auto full = VideoConfig(16, 16, PixelFormat::Rgb16_565);
+    full.input_full_range = 1;
+    REQUIRE(Read16(Run(SolidPicture(16, 16, 255, 128, 128).image, full), 0) == 0xFFFF);
+    REQUIRE(Read16(Run(SolidPicture(16, 16, 0, 128, 128).image, full), 0) == 0x0000);
+
+    // Custom coefficients (rgb_transform 0) are used as given.
+    auto custom = VideoConfig(16, 16, PixelFormat::Rgb16_565);
+    custom.rgb_transform = 0;
+    custom.coefficients = {256, 0, 0, 0, 0};
+    REQUIRE(Read16(Run(SolidPicture(16, 16, 16 + 128, 0, 255).image, custom), 0) ==
+            ((128 >> 3) << 11 | (128 >> 2) << 5 | (128 >> 3)));
+}
+
+TEST_CASE("MVD postprocessor writes YCbCr outputs", "[service][mvd]") {
+    const GradientPicture gradient(16, 16);
+    std::vector<u8> chroma;
+    const auto nv12 =
+        Run(gradient.image, VideoConfig(16, 16, PixelFormat::YCbCr420Semiplanar), &chroma);
+    REQUIRE(nv12 == gradient.luma);
+    REQUIRE(chroma == gradient.chroma);
+
+    const auto yuyv = Run(gradient.image, VideoConfig(16, 16, PixelFormat::YCbCr422Interleaved));
+    REQUIRE(yuyv[0] == gradient.At(0, 0));
+    REQUIRE(yuyv[1] == 128);
+    REQUIRE(yuyv[2] == gradient.At(1, 0));
+    REQUIRE(yuyv[3] == 128);
+    const auto uyvy = Run(gradient.image, VideoConfig(16, 16, PixelFormat::CbYCrY422Interleaved));
+    REQUIRE(uyvy[0] == 128);
+    REQUIRE(uyvy[1] == gradient.At(0, 0));
+}
