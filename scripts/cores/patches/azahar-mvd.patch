diff --git a/src/core/hle/service/mvd/h264_decoder.cpp b/src/core/hle/service/mvd/h264_decoder.cpp
new file mode 100644
index 0000000..d3b70de
--- /dev/null
+++ b/src/core/hle/service/mvd/h264_decoder.cpp
@@ -0,0 +1,339 @@
+// Copyright 2026 Azahar Emulator Project
+// Licensed under GPLv2 or any later version
+// Refer to the license.txt file included.
+
+#include <array>
+#include "core/hle/service/mvd/h264_decoder.h"
+
+#ifdef __APPLE__
+#include "core/hle/service/mvd/h264_decoder_videotoolbox.h"
+#endif
+
+namespace Service::MVD {
+
+namespace {
+
+/// Reads Exp-Golomb codes from a NAL unit's payload, skipping emulation prevention bytes.
+class RbspReader {
+public:
+    explicit RbspReader(std::span<const u8> payload) : payload(payload) {}
+
+    std::optional<u32> ReadBits(u32 count) {
+        u32 value = 0;
+        for (u32 i = 0; i < count; ++i) {
+            const auto bit = ReadBit();
+            if (!bit) {
+                return std::nullopt;
+            }
+            value = (value << 1) | *bit;
+        }
+        return value;
+    }
+
+    std::optional<s32> ReadSignedExpGolomb() {
+        const auto code = ReadUnsignedExpGolomb();
+        if (!code) {
+            return std::nullopt;
+        }
+        const s32 magnitude = static_cast<s32>((*code + 1) / 2);
+        return (*code & 1) ? magnitude : -magnitude;
+    }
+
+    std::optional<u32> ReadUnsignedExpGolomb() {
+        u32 leading_zeros = 0;
+        while (true) {
+            const auto bit = ReadBit();
+            if (!bit) {
+                return std::nullopt;
+            }
+            if (*bit) {
+                break;
+            }
+            if (++leading_zeros > 31) {
+                return std::nullopt;
+            }
+        }
+        u32 value = 0;
+        for (u32 i = 0; i < leading_zeros; ++i) {
+            const auto bit = ReadBit();
+            if (!bit) {
+                return std::nullopt;
+            }
+            value = (value << 1) | *bit;
+        }
+        return (1u << leading_zeros) - 1 + value;
+    }
+
+    std::optional<u32> ReadBit() {
+        if (bit_offset == 0) {
+            if (!NextByte()) {
+                return std::nullopt;
+            }
+        }
+        const u32 bit = (current >> (7 - bit_offset)) & 1;
+        bit_offset = (bit_offset + 1) % 8;
+        return bit;
+    }
+
+private:
+    bool NextByte() {
+        if (position >= payload.size()) {
+            return false;
+        }
+        // 00 00 03 inside a NAL unit is an emulation prevention sequence; the 03 isn't payload.
+        if (zero_run >= 2 && payload[position] == 0x03) {
+            zero_run = 0;
+            if (++position >= payload.size()) {
+                return false;
+            }
+        }
+        current = payload[position++];
+        zero_run = current == 0 ? zero_run + 1 : 0;
+        return true;
+    }
+
+    std::span<const u8> payload;
+    std::size_t position = 0;
+    u32 zero_run = 0;
+    u8 current = 0;
+    u32 bit_offset = 0;
+};
+
+/// Skips a scaling_list() (7.3.2.1.1.1); only its length matters here.
+bool SkipScalingList(RbspReader& reader, u32 size) {
+    s32 last_scale = 8;
+    s32 next_scale = 8;
+    for (u32 j = 0; j < size; ++j) {
+        if (next_scale != 0) {
+            const auto delta = reader.ReadSignedExpGolomb();
+            if (!delta) {
+                return false;
+            }
+            next_scale = (last_scale + *delta + 256) % 256;
+        }
+        last_scale = next_scale == 0 ? last_scale : next_scale;
+    }
+    return true;
+}
+
+/// Sample aspect ratios for aspect_ratio_idc 1..16 (table E-1).
+constexpr std::array<std::array<u32, 2>, 16> sample_aspect_ratios{{
+    {1, 1},
+    {12, 11},
+    {10, 11},
+    {16, 11},
+    {40, 33},
+    {24, 11},
+    {20, 11},
+    {32, 11},
+    {80, 33},
+    {18, 11},
+    {15, 11},
+    {64, 33},
+    {160, 99},
+    {4, 3},
+    {3, 2},
+    {2, 1},
+}};
+
+} // namespace
+
+H264Decoder::~H264Decoder() = default;
+
+NalUnitType GetNalUnitType(std::span<const u8> nal_unit) {
+    return nal_unit.empty() ? NalUnitType{0} : static_cast<NalUnitType>(nal_unit[0] & 0x1F);
+}
+
+u32 GetNalRefIdc(std::span<const u8> nal_unit) {
+    return nal_unit.empty() ? 0 : (nal_unit[0] >> 5) & 0x3;
+}
+
+std::optional<SequenceInfo> ParseSequenceParameterSet(std::span<const u8> nal_unit) {
+    if (GetNalUnitType(nal_unit) != NalUnitType::Sps) {
+        return std::nullopt;
+    }
+    RbspReader reader(nal_unit.subspan(1));
+    const auto profile_idc = reader.ReadBits(8);
+    if (!profile_idc || !reader.ReadBits(16) || !reader.ReadUnsignedExpGolomb()) {
+        return std::nullopt;
+    }
+
+    SequenceInfo info;
+    u32 chroma_format_idc = 1;
+    bool separate_colour_plane = false;
+    switch (*profile_idc) {
+    case 100:
+    case 110:
+    case 122:
+    case 244:
+    case 44:
+    case 83:
+    case 86:
+    case 118:
+    case 128:
+    case 138:
+    case 139:
+    case 134:
+    case 135: {
+        const auto chroma = reader.ReadUnsignedExpGolomb();
+        if (!chroma || *chroma > 3) {
+            return std::nullopt;
+        }
+        chroma_format_idc = *chroma;
+        if (chroma_format_idc == 3) {
+            separate_colour_plane = reader.ReadBit().value_or(0) != 0;
+        }
+        // bit_depth_luma/chroma_minus8, qpprime_y_zero_transform_bypass_flag
+        if (!reader.ReadUnsignedExpGolomb() || !reader.ReadUnsignedExpGolomb() ||
+            !reader.ReadBit()) {
+            return std::nullopt;
+        }
+        const auto scaling_matrix = reader.ReadBit();
+        if (!scaling_matrix) {
+            return std::nullopt;
+        }
+        if (*scaling_matrix) {
+            for (u32 i = 0; i < (chroma_format_idc != 3 ? 8u : 12u); ++i) {
+                const auto present = reader.ReadBit();
+                if (!present || (*present && !SkipScalingList(reader, i < 6 ? 16 : 64))) {
+                    return std::nullopt;
+                }
+            }
+        }
+        break;
+    }
+    default:
+        break;
+    }
+
+    // log2_max_frame_num_minus4
+    if (!reader.ReadUnsignedExpGolomb()) {
+        return std::nullopt;
+    }
+    const auto poc_type = reader.ReadUnsignedExpGolomb();
+    if (!poc_type) {
+        return std::nullopt;
+    }
+    if (*poc_type == 0) {
+        if (!reader.ReadUnsignedExpGolomb()) {
+            return std::nullopt;
+        }
+    } else if (*poc_type == 1) {
+        if (!reader.ReadBit() || !reader.ReadSignedExpGolomb() || !reader.ReadSignedExpGolomb()) {
+            return std::nullopt;
+        }
+        const auto cycle = reader.ReadUnsignedExpGolomb();
+        if (!cycle || *cycle > 255) {
+            return std::nullopt;
+        }
+        for (u32 i = 0; i < *cycle; ++i) {
+            if (!reader.ReadSignedExpGolomb()) {
+                return std::nullopt;
+            }
+        }
+    }
+
+    const auto max_ref_frames = reader.ReadUnsignedExpGolomb();
+    const auto gaps = reader.ReadBit();
+    const auto width_in_mbs = reader.ReadUnsignedExpGolomb();
+    const auto height_in_map_units = reader.ReadUnsignedExpGolomb();
+    const auto frame_mbs_only = reader.ReadBit();
+    if (!max_ref_frames || !gaps || !width_in_mbs || !height_in_map_units || !frame_mbs_only ||
+        *width_in_mbs >= 512 || *height_in_map_units >= 512) {
+        return std::nullopt;
+    }
+    if (!*frame_mbs_only && !reader.ReadBit()) {
+        return std::nullopt;
+    }
+    // direct_8x8_inference_flag
+    if (!reader.ReadBit()) {
+        return std::nullopt;
+    }
+    info.max_ref_frames = *max_ref_frames;
+    info.monochrome = chroma_format_idc == 0;
+    info.interlaced = !*frame_mbs_only;
+    info.coded_width = (*width_in_mbs + 1) * 16;
+    info.coded_height = (2 - *frame_mbs_only) * (*height_in_map_units + 1) * 16;
+
+    u32 crop_left = 0, crop_right = 0, crop_top = 0, crop_bottom = 0;
+    const auto cropping = reader.ReadBit();
+    if (!cropping) {
+        return std::nullopt;
+    }
+    if (*cropping) {
+        const auto left = reader.ReadUnsignedExpGolomb();
+        const auto right = reader.ReadUnsignedExpGolomb();
+        const auto top = reader.ReadUnsignedExpGolomb();
+        const auto bottom = reader.ReadUnsignedExpGolomb();
+        if (!left || !right || !top || !bottom) {
+            return std::nullopt;
+        }
+        crop_left = *left, crop_right = *right, crop_top = *top, crop_bottom = *bottom;
+    }
+    const u32 chroma_array_type = separate_colour_plane ? 0 : chroma_format_idc;
+    const u32 crop_unit_x = chroma_array_type == 0 ? 1 : (chroma_array_type == 3 ? 1 : 2);
+    const u32 crop_unit_y =
+        (chroma_array_type == 1 ? 2 : 1) * (2 - static_cast<u32>(*frame_mbs_only));
+    if (crop_unit_x * (crop_left + crop_right) >= info.coded_width ||
+        crop_unit_y * (crop_top + crop_bottom) >= info.coded_height) {
+        return std::nullopt;
+    }
+    info.crop_left = crop_unit_x * crop_left;
+    info.crop_top = crop_unit_y * crop_top;
+    info.crop_width = info.coded_width - crop_unit_x * (crop_left + crop_right);
+    info.crop_height = info.coded_height - crop_unit_y * (crop_top + crop_bottom);
+
+    // The VUI is optional; a truncated one keeps what was read so far.
+    if (reader.ReadBit().value_or(0)) {
+        if (reader.ReadBit().value_or(0)) {
+            const u32 idc = reader.ReadBits(8).value_or(0);
+            if (idc == 255) {
+                info.sar_width = reader.ReadBits(16).value_or(0);
+                info.sar_height = reader.ReadBits(16).value_or(0);
+            } else if (idc >= 1 && idc <= sample_aspect_ratios.size()) {
+                info.sar_width = sample_aspect_ratios[idc - 1][0];
+                info.sar_height = sample_aspect_ratios[idc - 1][1];
+            }
+        }
+        if (reader.ReadBit().value_or(0)) {
+            reader.ReadBit(); // overscan_appropriate_flag
+        }
+        if (reader.ReadBit().value_or(0)) {
+            reader.ReadBits(3); // video_format
+            info.full_range = reader.ReadBit().value_or(0) != 0;
+            if (reader.ReadBit().value_or(0)) {
+                reader.ReadBits(16); // colour_primaries, transfer_characteristics
+                info.matrix_coefficients = reader.ReadBits(8).value_or(2);
+            }
+        }
+    }
+    return info;
+}
+
+std::optional<u32> GetFirstMbInSlice(std::span<const u8> nal_unit) {
+    const auto type = GetNalUnitType(nal_unit);
+    if (type != NalUnitType::Slice && type != NalUnitType::IdrSlice) {
+        return std::nullopt;
+    }
+    return RbspReader(nal_unit.subspan(1)).ReadUnsignedExpGolomb();
+}
+
+std::span<const u8> StripStartCode(std::span<const u8> data) {
+    if (data.size() >= 4 && data[0] == 0 && data[1] == 0 && data[2] == 0 && data[3] == 1) {
+        return data.subspan(4);
+    }
+    if (data.size() >= 3 && data[0] == 0 && data[1] == 0 && data[2] == 1) {
+        return data.subspan(3);
+    }
+    return data;
+}
+
+std::unique_ptr<H264Decoder> CreateH264Decoder() {
+#ifdef __APPLE__
+    return std::make_unique<VideoToolboxH264Decoder>();
+#else
+    return nullptr;
+#endif
+}
+
+} // namespace Service::MVD
