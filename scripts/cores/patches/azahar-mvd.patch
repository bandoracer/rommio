+++ b/src/core/hle/service/mvd/h264_decoder_videotoolbox.cpp
@@ -0,0 +1,283 @@
+// Copyright 2026 Azahar Emulator Project
+// Licensed under GPLv2 or any later version
+// Refer to the license.txt file included.
+
+#include <cstring>
+#include <map>
+#include <CoreFoundation/CoreFoundation.h>
+#include <CoreMedia/CoreMedia.h>
+#include <CoreVideo/CoreVideo.h>
+#include <VideoToolbox/VideoToolbox.h>
+#include "common/logging/log.h"
+#include "core/hle/service/mvd/h264_decoder_videotoolbox.h"
+
+namespace Service::MVD {
+
+namespace {
+
+/// The session is gone, e.g. iOS reclaimed the hardware decoder while the app was in the
+/// background (kVTInvalidSessionErr).
+constexpr OSStatus InvalidSession = -12903;
+
+template <typename T>
+struct CFDeleter {
+    void operator()(T ref) const {
+        if (ref) {
+            CFRelease(ref);
+        }
+    }
+};
+template <typename T>
+using CFPtr = std::unique_ptr<std::remove_pointer_t<T>, CFDeleter<T>>;
+
+DecodedPicture CopyPicture(CVImageBufferRef image) {
+    DecodedPicture picture;
+    CVPixelBufferLockBaseAddress(image, kCVPixelBufferLock_ReadOnly);
+    picture.width = static_cast<u32>(CVPixelBufferGetWidth(image));
+    picture.height = static_cast<u32>(CVPixelBufferGetHeight(image));
+    const std::size_t chroma_width = (picture.width + 1) / 2 * 2;
+    const std::size_t chroma_rows = (picture.height + 1) / 2;
+    picture.luma.resize(std::size_t{picture.width} * picture.height);
+    picture.chroma.resize(chroma_width * chroma_rows);
+
+    const auto* luma = static_cast<const u8*>(CVPixelBufferGetBaseAddressOfPlane(image, 0));
+    const std::size_t luma_stride = CVPixelBufferGetBytesPerRowOfPlane(image, 0);
+    for (u32 row = 0; row < picture.height; ++row) {
+        std::memcpy(picture.luma.data() + std::size_t{row} * picture.width,
+                    luma + row * luma_stride, picture.width);
+    }
+    const auto* chroma = static_cast<const u8*>(CVPixelBufferGetBaseAddressOfPlane(image, 1));
+    const std::size_t chroma_stride = CVPixelBufferGetBytesPerRowOfPlane(image, 1);
+    for (std::size_t row = 0; row < chroma_rows; ++row) {
+        std::memcpy(picture.chroma.data() + row * chroma_width, chroma + row * chroma_stride,
+                    chroma_width);
+    }
+    CVPixelBufferUnlockBaseAddress(image, kCVPixelBufferLock_ReadOnly);
+    return picture;
+}
+
+} // namespace
+
+struct VideoToolboxH264Decoder::Impl {
+    ~Impl() {
+        DestroySession();
+    }
+
+    std::vector<DecodedPicture> Decode(std::span<const u8> nal_unit) {
+        std::vector<DecodedPicture> pictures;
+        if (nal_unit.empty()) {
+            return pictures;
+        }
+        const auto type = GetNalUnitType(nal_unit);
+        if (type == NalUnitType::Slice || type == NalUnitType::IdrSlice) {
+            const auto first_mb = GetFirstMbInSlice(nal_unit);
+            if (!first_mb) {
+                LOG_WARNING(Service_MVD, "Dropping a slice with a truncated header");
+                return pictures;
+            }
+            if (*first_mb == 0) {
+                AppendPictures(pictures, Flush());
+                slices.emplace_back(nal_unit.begin(), nal_unit.end());
+                // Every picture is assumed to be a single slice until a stream shows otherwise,
+                // so it is decoded as soon as its slice arrives, like the hardware reports it.
+                if (single_slice_pictures) {
+                    AppendPictures(pictures, Flush());
+                }
+            } else if (single_slice_pictures) {
+                LOG_WARNING(Service_MVD, "Stream has multi-slice pictures; decoding each picture "
+                                         "when the next one starts");
+                single_slice_pictures = false;
+                // The first slice of this picture was already decoded on its own.
+            } else if (!slices.empty()) {
+                slices.emplace_back(nal_unit.begin(), nal_unit.end());
+            }
+            return pictures;
+        }
+
+        // Any other NAL unit begins a new access unit (H.264 7.4.1.2.3).
+        AppendPictures(pictures, Flush());
+        if (type == NalUnitType::Sps || type == NalUnitType::Pps) {
+            auto& sets = type == NalUnitType::Sps ? sps : pps;
+            std::vector<u8> bytes(nal_unit.begin(), nal_unit.end());
+            if (sets != bytes) {
+                sets = std::move(bytes);
+                DestroySession();
+            }
+        }
+        return pictures;
+    }
+
+    std::vector<DecodedPicture> Flush() {
+        std::vector<DecodedPicture> pictures;
+        if (slices.empty()) {
+            return pictures;
+        }
+        const bool idr = GetNalUnitType(slices.front()) == NalUnitType::IdrSlice;
+        std::vector<u8> sample;
+        for (const auto& slice : slices) {
+            const auto size = static_cast<u32>(slice.size());
+            const u8 length[4] = {static_cast<u8>(size >> 24), static_cast<u8>(size >> 16),
+                                  static_cast<u8>(size >> 8), static_cast<u8>(size)};
+            sample.insert(sample.end(), std::begin(length), std::end(length));
+            sample.insert(sample.end(), slice.begin(), slice.end());
+        }
+        slices.clear();
+
+        if (awaiting_idr && !idr) {
+            return pictures;
+        }
+        if (!session && !CreateSession()) {
+            return pictures;
+        }
+        awaiting_idr = false;
+
+        OSStatus status = DecodeSample(sample);
+        if (status == InvalidSession) {
+            LOG_INFO(Service_MVD, "VideoToolbox session was invalidated; recreating it");
+            DestroySession();
+            if (!idr || !CreateSession()) {
+                awaiting_idr = true;
+                return pictures;
+            }
+            status = DecodeSample(sample);
+        }
+        if (status != noErr) {
+            LOG_ERROR(Service_MVD, "VideoToolbox failed to decode a picture: {}", status);
+        }
+        pictures = std::move(decoded);
+        decoded.clear();
+        return pictures;
+    }
+
+    void Reset() {
+        DestroySession();
+        sps.clear();
+        pps.clear();
+        slices.clear();
+        decoded.clear();
+        awaiting_idr = false;
+        single_slice_pictures = true;
+    }
+
+private:
+    static void AppendPictures(std::vector<DecodedPicture>& into,
+                               std::vector<DecodedPicture>&& pictures) {
+        for (auto& picture : pictures) {
+            into.push_back(std::move(picture));
+        }
+    }
+
+    static void OnDecoded(void* refcon, void*, OSStatus status, VTDecodeInfoFlags,
+                          CVImageBufferRef image, CMTime, CMTime) {
+        auto* self = static_cast<Impl*>(refcon);
+        if (status != noErr || !image) {
+            LOG_ERROR(Service_MVD, "VideoToolbox reported a decode error: {}", status);
+            return;
+        }
+        self->decoded.push_back(CopyPicture(image));
+    }
+
+    bool CreateSession() {
+        if (sps.empty() || pps.empty()) {
+            LOG_WARNING(Service_MVD, "Received a picture before its parameter sets");
+            return false;
+        }
+        const u8* sets[2] = {sps.data(), pps.data()};
+        const std::size_t sizes[2] = {sps.size(), pps.size()};
+        CMVideoFormatDescriptionRef description = nullptr;
+        OSStatus status = CMVideoFormatDescriptionCreateFromH264ParameterSets(
+            kCFAllocatorDefault, 2, sets, sizes, 4, &description);
+        if (status != noErr) {
+            LOG_ERROR(Service_MVD, "Invalid H.264 parameter sets: {}", status);
+            return false;
+        }
+        format.reset(description);
+
+        const SInt32 pixel_format = kCVPixelFormatType_420YpCbCr8BiPlanarVideoRange;
+        CFPtr<CFNumberRef> pixel_format_number(
+            CFNumberCreate(kCFAllocatorDefault, kCFNumberSInt32Type, &pixel_format));
+        const void* keys[] = {kCVPixelBufferPixelFormatTypeKey};
+        const void* values[] = {pixel_format_number.get()};
+        CFPtr<CFDictionaryRef> attributes(CFDictionaryCreate(kCFAllocatorDefault, keys, values, 1,
+                                                             &kCFTypeDictionaryKeyCallBacks,
+                                                             &kCFTypeDictionaryValueCallBacks));
+
+        const VTDecompressionOutputCallbackRecord callback{&OnDecoded, this};
+        VTDecompressionSessionRef created = nullptr;
+        status = VTDecompressionSessionCreate(kCFAllocatorDefault, format.get(), nullptr,
+                                              attributes.get(), &callback, &created);
+        if (status != noErr) {
+            LOG_ERROR(Service_MVD, "Could not create a VideoToolbox session: {}", status);
+            format.reset();
+            return false;
+        }
+        session = created;
+        return true;
+    }
+
+    void DestroySession() {
+        if (session) {
+            VTDecompressionSessionWaitForAsynchronousFrames(session);
+            VTDecompressionSessionInvalidate(session);
+            CFRelease(session);
+            session = nullptr;
+        }
+        format.reset();
+    }
+
+    OSStatus DecodeSample(const std::vector<u8>& sample) {
+        CMBlockBufferRef block = nullptr;
+        OSStatus status = CMBlockBufferCreateWithMemoryBlock(
+            kCFAllocatorDefault, nullptr, sample.size(), kCFAllocatorDefault, nullptr, 0,
+            sample.size(), kCMBlockBufferAssureMemoryNowFlag, &block);
+        if (status != noErr) {
+            return status;
+        }
+        CFPtr<CMBlockBufferRef> block_owner(block);
+        status = CMBlockBufferReplaceDataBytes(sample.data(), block, 0, sample.size());
+        if (status != noErr) {
+            return status;
+        }
+        CMSampleBufferRef buffer = nullptr;
+        const std::size_t sample_size = sample.size();
+        status = CMSampleBufferCreateReady(kCFAllocatorDefault, block, format.get(), 1, 0, nullptr,
+                                           1, &sample_size, &buffer);
+        if (status != noErr) {
+            return status;
+        }
+        CFPtr<CMSampleBufferRef> buffer_owner(buffer);
+        // Without the asynchronous flag the output callback runs before this returns.
+        status = VTDecompressionSessionDecodeFrame(session, buffer, 0, nullptr, nullptr);
+        if (status == noErr) {
+            VTDecompressionSessionWaitForAsynchronousFrames(session);
+        }
+        return status;
+    }
+
+    std::vector<u8> sps;
+    std::vector<u8> pps;
+    std::vector<std::vector<u8>> slices;
+    std::vector<DecodedPicture> decoded;
+    CFPtr<CMVideoFormatDescriptionRef> format;
+    VTDecompressionSessionRef session = nullptr;
+    bool awaiting_idr = false;
+    bool single_slice_pictures = true;
+};
+
+VideoToolboxH264Decoder::VideoToolboxH264Decoder() : impl(std::make_unique<Impl>()) {}
+
+VideoToolboxH264Decoder::~VideoToolboxH264Decoder() = default;
+
+std::vector<DecodedPicture> VideoToolboxH264Decoder::Decode(std::span<const u8> nal_unit) {
+    return impl->Decode(nal_unit);
+}
+
+std::vector<DecodedPicture> VideoToolboxH264Decoder::Flush() {
+    return impl->Flush();
+}
+
+void VideoToolboxH264Decoder::Reset() {
+    impl->Reset();
+}
