+/// SetConfig rejections, in Hantro's order starting at PP_SET_IN_SIZE_INVALID (-64).
+enum class ConfigError : u32 {
+    InputSize = 0,
+    InputAddress,
+    InputFormat,
+    Crop,
+    Rotation,
+    OutputSize,
+    OutputAddress,
+    OutputFormat,
+    ColorAdjustment,
+    RgbMasks,
+    FrameBuffer,
+    Mask1,
+    Mask2,
+    Deinterlace,
+    InputStructure,
+    InputRangeMapping,
+};
+
+constexpr u32 Reject(ConfigError error) {
+    return 0xD9617108 + static_cast<u32>(error);
+}
+
+constexpr bool IsAligned(u32 value, u32 alignment) {
+    return value % alignment == 0;
+}
+
+constexpr bool IsValidAddress(u32 address) {
+    return address != 0 && IsAligned(address, 8);
+}
+
+bool IsPacked422(PixelFormat format) {
+    switch (format) {
+    case PixelFormat::YCbCr422Interleaved:
+    case PixelFormat::YCrYCb422Interleaved:
+    case PixelFormat::CbYCrY422Interleaved:
+    case PixelFormat::CrYCbY422Interleaved:
+        return true;
+    default:
+        return false;
+    }
+}
+
+bool IsRgb(PixelFormat format) {
+    return (static_cast<u32>(format) & 0x00040000) != 0;
+}
+
+bool IsRgb32(PixelFormat format) {
+    return (static_cast<u32>(format) & 0x00041000) == 0x00041000;
+}
+
+/// Byte positions of Y0, Cb, Y1 and Cr within a packed 4:2:2 pixel pair.
+std::array<u32, 4> Packed422Order(PixelFormat format) {
+    switch (format) {
+    case PixelFormat::YCrYCb422Interleaved:
+        return {0, 3, 2, 1};
+    case PixelFormat::CbYCrY422Interleaved:
+        return {1, 0, 3, 2};
+    case PixelFormat::CrYCbY422Interleaved:
+        return {1, 2, 3, 0};
+    default:
+        return {0, 1, 2, 3};
+    }
+}
+
+bool IsContiguousMask(u32 mask) {
+    if (mask == 0) {
+        return true;
+    }
+    const u32 shifted = mask >> std::countr_zero(mask);
+    return (shifted & (shifted + 1)) == 0;
+}
+
+struct YCbCr {
+    u8 y, cb, cr;
+};
+
+/// Reads Y, Cb and Cr from the source at a (possibly fractional) luma position.
+class Sampler {
+public:
+    explicit Sampler(const SourceImage& source) : source(source) {}
+
+    YCbCr At(u32 x, u32 y) const {
+        x = std::min(x, source.width - 1);
+        y = std::min(y, source.height - 1);
+        const u8 luma = source.luma[std::size_t{y} * source.luma_stride + x];
+        if (source.monochrome) {
+            return {luma, 128, 128};
+        }
+        const u32 cy = source.chroma_full_height ? y : y / 2;
+        const std::size_t c = std::size_t{cy} * source.chroma_stride + (x / 2) * 2;
+        return {luma, source.chroma[c], source.chroma[c + 1]};
+    }
+
+    YCbCr Bilinear(float x, float y) const {
+        const float luma = Plane(x, y, source.width, source.height, [this](u32 px, u32 py) {
+            return source.luma[std::size_t{py} * source.luma_stride + px];
+        });
+        if (source.monochrome) {
+            return {Round(luma), 128, 128};
+        }
+        // Chroma samples sit at the left of each pixel pair and, for 4:2:0, between the rows.
+        const float cx = x / 2.0f;
+        const float cy = source.chroma_full_height ? y : (y + 0.5f) / 2.0f - 0.5f;
+        const u32 chroma_width = (source.width + 1) / 2;
+        const u32 chroma_height =
+            source.chroma_full_height ? source.height : (source.height + 1) / 2;
+        const float cb = Plane(cx, cy, chroma_width, chroma_height, [this](u32 px, u32 py) {
+            return source.chroma[std::size_t{py} * source.chroma_stride + px * 2];
+        });
+        const float cr = Plane(cx, cy, chroma_width, chroma_height, [this](u32 px, u32 py) {
+            return source.chroma[std::size_t{py} * source.chroma_stride + px * 2 + 1];
+        });
+        return {Round(luma), Round(cb), Round(cr)};
+    }
+
+private:
+    template <typename Fetch>
+    static float Plane(float x, float y, u32 width, u32 height, Fetch&& fetch) {
+        x = std::clamp(x, 0.0f, static_cast<float>(width - 1));
+        y = std::clamp(y, 0.0f, static_cast<float>(height - 1));
+        const u32 x0 = static_cast<u32>(x), y0 = static_cast<u32>(y);
+        const u32 x1 = std::min(x0 + 1, width - 1), y1 = std::min(y0 + 1, height - 1);
+        const float fx = x - static_cast<float>(x0), fy = y - static_cast<float>(y0);
+        const float top = fetch(x0, y0) * (1 - fx) + fetch(x1, y0) * fx;
+        const float bottom = fetch(x0, y1) * (1 - fx) + fetch(x1, y1) * fx;
+        return top * (1 - fy) + bottom * fy;
+    }
+
+    static u8 Round(float value) {
+        return static_cast<u8>(std::clamp(std::lround(value), 0L, 255L));
+    }
+
+    const SourceImage& source;
+};
+
+/// YCbCr to RGB with the postprocessor's 8.8 fixed-point coefficients a..e.
+class ColorConverter {
+public:
+    explicit ColorConverter(const PostprocessorConfig& config) {
+        // Coefficients for BT.601 and BT.709, limited then full range.
+        static constexpr std::array<std::array<s32, 5>, 4> standard{{
+            {298, 409, 208, 100, 516},
+            {256, 350, 179, 86, 443},
+            {298, 459, 137, 55, 544},
+            {256, 403, 120, 48, 475},
+        }};
+        const bool full_range = config.input_full_range != 0;
+        if (config.rgb_transform == 1 || config.rgb_transform == 2) {
+            const auto& set = standard[(config.rgb_transform - 1) * 2 + (full_range ? 1 : 0)];
+            std::copy(set.begin(), set.end(), coefficients.begin());
+        } else {
+            std::transform(config.coefficients.begin(), config.coefficients.end(),
+                           coefficients.begin(), [](u32 c) { return static_cast<s32>(c); });
+        }
+        // Saturation scales the chroma coefficients, as Hantro's driver programs them.
+        const s32 saturation = 64 + config.saturation;
+        for (std::size_t i = 1; i < coefficients.size(); ++i) {
+            coefficients[i] = std::clamp(saturation * coefficients[i] / 64, 0, 1023);
+        }
+        luma_offset = full_range ? 0 : 16;
+        brightness = config.brightness;
+    }
+
+    std::array<u8, 3> ToRgb(YCbCr in) const {
+        const s32 y = coefficients[0] * (static_cast<s32>(in.y) - luma_offset);
+        const s32 cb = static_cast<s32>(in.cb) - 128;
+        const s32 cr = static_cast<s32>(in.cr) - 128;
+        const auto channel = [this](s32 value) {
+            return static_cast<u8>(std::clamp(((value + 128) >> 8) + brightness, 0, 255));
+        };
+        return {channel(y + coefficients[1] * cr),
+                channel(y - coefficients[2] * cr - coefficients[3] * cb),
+                channel(y + coefficients[4] * cb)};
+    }
+
+private:
+    std::array<s32, 5> coefficients{};
+    s32 luma_offset = 16;
+    s32 brightness = 0;
+};
+
+u32 PackMasked(std::array<u8, 3> rgb, u32 mask_r, u32 mask_g, u32 mask_b, u32 mask_alpha) {
+    const auto place = [](u8 value, u32 mask) -> u32 {
+        if (mask == 0) {
+            return 0;
+        }
+        const u32 shift = std::countr_zero(mask);
+        const u32 bits = std::popcount(mask);
+        const u32 scaled = bits >= 8 ? u32{value} << (bits - 8) : u32{value} >> (8 - bits);
+        return (scaled << shift) & mask;
+    };
+    return place(rgb[0], mask_r) | place(rgb[1], mask_g) | place(rgb[2], mask_b) | mask_alpha;
+}
+
+void Write16(std::span<u8> plane, std::size_t offset, u16 value) {
+    plane[offset] = static_cast<u8>(value);
+    plane[offset + 1] = static_cast<u8>(value >> 8);
+}
+
+/// 32-bit RGB words are stored most significant byte first (alpha at the lowest address).
+void Write32(std::span<u8> plane, std::size_t offset, u32 value) {
+    plane[offset] = static_cast<u8>(value >> 24);
+    plane[offset + 1] = static_cast<u8>(value >> 16);
+    plane[offset + 2] = static_cast<u8>(value >> 8);
+    plane[offset + 3] = static_cast<u8>(value);
+}
