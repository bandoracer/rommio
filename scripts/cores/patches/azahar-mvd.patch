@@ -0,0 +1,91 @@
+// Copyright 2026 Azahar Emulator Project
+// Licensed under GPLv2 or any later version
+// Refer to the license.txt file included.
+
+#pragma once
+
+#include <memory>
+#include <optional>
+#include <span>
+#include <vector>
+#include "common/common_types.h"
+
+namespace Service::MVD {
+
+/// A decoded picture in NV12: a full-resolution luma plane followed by one half-resolution plane of
+/// interleaved Cb/Cr samples. Both planes are tightly packed (stride equals width, rounded up to an
+/// even number of samples for chroma).
+struct DecodedPicture {
+    u32 width = 0;
+    u32 height = 0;
+    std::vector<u8> luma;
+    std::vector<u8> chroma;
+};
+
+/// NAL unit types from ITU-T H.264 table 7-1 that the decoders care about.
+enum class NalUnitType : u8 {
+    Slice = 1,
+    IdrSlice = 5,
+    Sei = 6,
+    Sps = 7,
+    Pps = 8,
+    AccessUnitDelimiter = 9,
+    EndOfSequence = 10,
+    EndOfStream = 11,
+};
+
+/// What MVD reports about a stream, from its sequence parameter set (ITU-T H.264 7.3.2.1.1, E.1.1).
+struct SequenceInfo {
+    u32 coded_width = 0;  ///< In pixels, a multiple of 16.
+    u32 coded_height = 0; ///< In pixels, a multiple of 16 (32 for field-coded streams).
+    u32 crop_left = 0;
+    u32 crop_top = 0;
+    u32 crop_width = 0;
+    u32 crop_height = 0;
+    bool full_range = false;
+    u32 matrix_coefficients = 2; ///< 2 is "unspecified".
+    u32 sar_width = 0;
+    u32 sar_height = 0;
+    bool monochrome = false;
+    bool interlaced = false;
+    u32 max_ref_frames = 0;
+};
+
+/// The type of a NAL unit given without its start code.
+NalUnitType GetNalUnitType(std::span<const u8> nal_unit);
+
+/// The nal_ref_idc of a NAL unit given without its start code; 0 for non-reference pictures.
+u32 GetNalRefIdc(std::span<const u8> nal_unit);
+
+/// Parses a sequence parameter set NAL unit (given without its start code).
+std::optional<SequenceInfo> ParseSequenceParameterSet(std::span<const u8> nal_unit);
+
+/// For a slice NAL unit, the slice header's first_mb_in_slice; std::nullopt for other NAL units or
+/// a truncated header.
+std::optional<u32> GetFirstMbInSlice(std::span<const u8> nal_unit);
+
+/// Removes a leading Annex B start code (00 00 01 or 00 00 00 01), if present.
+std::span<const u8> StripStartCode(std::span<const u8> data);
+
+/// Decodes an H.264 elementary stream one NAL unit at a time, the way the New 3DS MVD hardware
+/// receives it. Parameter sets are remembered; each picture is decoded once its slices are
+/// complete.
+class H264Decoder {
+public:
+    virtual ~H264Decoder();
+
+    /// Decodes one NAL unit given without its start code. Returns the pictures this unit completed,
+    /// in output order (usually none or one).
+    virtual std::vector<DecodedPicture> Decode(std::span<const u8> nal_unit) = 0;
+
+    /// Completes the picture whose slices have been received so far, if any.
+    virtual std::vector<DecodedPicture> Flush() = 0;
+
+    /// Forgets all parameter sets, reference pictures and pending slices.
+    virtual void Reset() = 0;
+};
+
+/// Creates the best decoder available on this platform, or nullptr when none is.
+std::unique_ptr<H264Decoder> CreateH264Decoder();
+
+} // namespace Service::MVD
diff --git a/src/core/hle/service/mvd/h264_decoder_videotoolbox.cpp b/src/core/hle/service/mvd/h264_decoder_videotoolbox.cpp
