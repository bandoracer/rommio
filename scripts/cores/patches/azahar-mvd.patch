+TEST_CASE("MVD postprocessor crops, places, rotates and scales", "[service][mvd]") {
+    // Video input is at least 48 pixels wide.
+    const GradientPicture gradient(64, 64);
+
+    SECTION("crop into a frame buffer") {
+        auto config = VideoConfig(64, 64, PixelFormat::YCbCr420Semiplanar);
+        config.crop_enable = 1;
+        config.crop_x = 16;
+        config.crop_y = 16;
+        config.crop_width = 48;
+        config.crop_height = 16;
+        config.output_width = 48;
+        config.output_height = 16;
+        config.frame_buffer_enable = 1;
+        config.frame_buffer_x = 4;
+        config.frame_buffer_y = 2;
+        config.frame_buffer_width = 64;
+        config.frame_buffer_height = 24;
+        REQUIRE(ValidateConfig(config, true) == 0);
+        const auto luma = Run(gradient.image, config, nullptr, 0xEE);
+        REQUIRE(luma.size() == 64 * 24);
+        REQUIRE(luma[2 * 64 + 4] == gradient.At(16, 16));
+        REQUIRE(luma[17 * 64 + 51] == gradient.At(63, 31));
+        REQUIRE(luma[0] == 0xEE);
+        REQUIRE(luma[2 * 64 + 3] == 0xEE);
+        REQUIRE(luma[18 * 64 + 4] == 0xEE);
+    }
+
+    SECTION("frame buffer clips a picture placed partly outside") {
+        auto config = VideoConfig(64, 64, PixelFormat::YCbCr420Semiplanar);
+        config.frame_buffer_enable = 1;
+        config.frame_buffer_x = -8;
+        config.frame_buffer_y = -4;
+        config.frame_buffer_width = 16;
+        config.frame_buffer_height = 16;
+        REQUIRE(ValidateConfig(config, true) == 0);
+        const auto luma = Run(gradient.image, config);
+        REQUIRE(luma[0] == gradient.At(8, 4));
+        REQUIRE(luma[15 * 16 + 15] == gradient.At(23, 19));
+    }
+
+    SECTION("rotation") {
+        const GradientPicture tall(48, 64);
+        auto config = VideoConfig(48, 64, PixelFormat::YCbCr420Semiplanar);
+        config.output_width = 64;
+        config.output_height = 48;
+        config.rotation = 1; // 90 degrees right: the source's bottom-left lands top-left
+        REQUIRE(ValidateConfig(config, true) == 0);
+        auto luma = Run(tall.image, config);
+        REQUIRE(luma[0] == tall.At(0, 63));
+        REQUIRE(luma[63] == tall.At(0, 0));
+        config.rotation = 2; // 90 degrees left
+        luma = Run(tall.image, config);
+        REQUIRE(luma[0] == tall.At(47, 0));
+
+        auto flip = VideoConfig(64, 64, PixelFormat::YCbCr420Semiplanar);
+        flip.rotation = 3; // horizontal flip
+        REQUIRE(Run(gradient.image, flip)[0] == gradient.At(63, 0));
+        flip.rotation = 4; // vertical flip
+        REQUIRE(Run(gradient.image, flip)[0] == gradient.At(0, 63));
+        flip.rotation = 5; // 180 degrees
+        REQUIRE(Run(gradient.image, flip)[0] == gradient.At(63, 63));
+    }
+
+    SECTION("scaling") {
+        auto config = VideoConfig(64, 64, PixelFormat::YCbCr420Semiplanar);
+        config.output_width = 128;
+        config.output_height = 128;
+        REQUIRE(ValidateConfig(config, true) == 0);
+        const auto up = Run(gradient.image, config);
+        REQUIRE(up[0] == gradient.At(0, 0));
+        REQUIRE(up[128 * 128 - 1] == gradient.At(63, 63));
+        // Output pixels 1 and 2 sample a quarter and three quarters of the way to the next
+        // source pixel (16 and 17 here).
+        REQUIRE(up[1] == 16);
+        REQUIRE(up[2] == 17);
+
+        config.output_width = 32;
+        config.output_height = 32;
+        REQUIRE(ValidateConfig(config, true) == 0);
+        const auto down = Run(gradient.image, config);
+        // Each output pixel lands between four source pixels: (16 + 17 + 18 + 19) / 4, rounded.
+        REQUIRE(down[0] == 18);
+    }
+}
