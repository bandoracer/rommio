+/// An NAL unit of an Annex B buffer and the offset of its start code.
+struct AnnexBUnit {
+    std::size_t start_code;
+    std::span<const u8> nal_unit;
+};
+
+std::vector<AnnexBUnit> SplitAnnexB(std::span<const u8> data) {
+    std::vector<std::size_t> payloads;
+    for (std::size_t i = 0; i + 3 <= data.size(); ++i) {
+        if (data[i] == 0 && data[i + 1] == 0 && data[i + 2] == 1) {
+            payloads.push_back(i + 3);
+            i += 2;
+        }
+    }
+    std::vector<AnnexBUnit> units;
+    if (payloads.empty()) {
+        // Without a start code the whole buffer is taken as one NAL unit.
+        if (!data.empty()) {
+            units.push_back({0, data});
+        }
+        return units;
+    }
+    for (std::size_t i = 0; i < payloads.size(); ++i) {
+        const std::size_t start = payloads[i];
+        std::size_t end = i + 1 < payloads.size() ? payloads[i + 1] - 3 : data.size();
+        // Zero bytes before the next start code belong to it (or are trailing_zero_8bits).
+        while (end > start && data[end - 1] == 0) {
+            --end;
+        }
+        std::size_t start_code = start - 3;
+        if (start_code > 0 && data[start_code - 1] == 0) {
+            --start_code;
+        }
+        if (end > start) {
+            units.push_back({start_code, data.subspan(start, end - start)});
+        }
+    }
+    return units;
+}
