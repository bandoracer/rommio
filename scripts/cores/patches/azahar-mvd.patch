+    rb.Push<u32>(0);
+}
+
+void MVD_STD::ProcessNALUnit(Kernel::HLERequestContext& ctx) {
+    IPC::RequestParser rp(ctx);
+    const VAddr vaddr = rp.Pop<u32>();
+    const PAddr paddr = rp.Pop<u32>();
+    const u32 size = rp.Pop<u32>();
+    const u32 picture_id = rp.Pop<u32>();
+    const bool skip_non_reference = rp.Pop<u32>() != 0;
+    const auto process = rp.PopObject<Kernel::Process>();
+
+    IPC::RequestBuilder rb = rp.MakeBuilder(4, 0);
+    if (!h264_initialized) {
+        rb.Push<u32>(ErrorNotInitialized);
+        rb.Push<u32>(vaddr);
+        rb.Push<u32>(paddr);
+        rb.Push<u32>(size);
+        return;
+    }
+
+    // The hardware reads the input from its physical address.
+    std::vector<u8> input(size);
+    if (size != 0 && memory.IsValidPhysicalAddress(paddr) &&
+        memory.IsValidPhysicalAddress(paddr + size - 1)) {
+        std::memcpy(input.data(), memory.GetPhysicalPointer(paddr), size);
+    } else if (process) {
+        memory.ReadBlock(*process, vaddr, input.data(), size);
+    }
+
+    u32 status = StatusStreamProcessed;
+    std::size_t consumed = input.size();
+    for (const auto& unit : SplitAnnexB(input)) {
+        const auto type = GetNalUnitType(unit.nal_unit);
+        const bool slice = type == NalUnitType::Slice || type == NalUnitType::IdrSlice;
+        if (slice && headers_pending) {
+            // A new sequence's first picture: the client reads the stream information, sets up
+            // the output, and passes the rest of the input again.
+            headers_pending = false;
+            status = StatusHeadersReady;
+            consumed = unit.start_code;
+            break;
+        }
+        if (slice && skip_non_reference && GetNalRefIdc(unit.nal_unit) == 0) {
+            status = StatusNonReferenceSkipped;
+            continue;
+        }
+        const u32 unit_status = DecodeNalUnit(unit.nal_unit, picture_id);
+        if (unit_status == StatusPictureDecoded) {
+            status = unit_status;
+        }
+    }
+    if (status == StatusNonReferenceSkipped) {
+        consumed = input.size();
+    }
+
+    rb.Push<u32>(status);
+    rb.Push<u32>(vaddr + static_cast<u32>(consumed));
+    rb.Push<u32>(paddr + static_cast<u32>(consumed));
+    rb.Push<u32>(size - static_cast<u32>(consumed));
+    LOG_TRACE(Service_MVD, "called, size=0x{:X} id={} status=0x{:X} consumed=0x{:X}", size,
+              picture_id, status, consumed);
+}
+
+u32 MVD_STD::DecodeNalUnit(std::span<const u8> nal_unit, u32 picture_id) {
+    const auto type = GetNalUnitType(nal_unit);
+    if (type == NalUnitType::Sps) {
+        if (!std::ranges::equal(nal_unit, active_sps)) {
+            if (auto info = ParseSequenceParameterSet(nal_unit)) {
+                active_sps.assign(nal_unit.begin(), nal_unit.end());
+                sequence = info;
+                headers_pending = true;
+            } else {
+                LOG_WARNING(Service_MVD, "Could not parse a sequence parameter set");
+            }
+        }
+    } else if (type == NalUnitType::Pps) {
+        active_pps.assign(nal_unit.begin(), nal_unit.end());
+    }
+
+    if (!decoder) {
+        if (!warned_no_decoder) {
+            LOG_ERROR(Service_MVD, "No H.264 decoder is available on this platform; MVD video "
+                                   "will not be shown");
+            warned_no_decoder = true;
+        }
+        return StatusStreamProcessed;
+    }
+    const bool idr = type == NalUnitType::IdrSlice;
+    auto decoded = decoder->Decode(nal_unit);
+    if (decoded.empty()) {
+        return StatusStreamProcessed;
+    }
+    QueuePictures(std::move(decoded), picture_id, idr);
+    return StatusPictureDecoded;
+}
+
+void MVD_STD::QueuePictures(std::vector<DecodedPicture>&& decoded, u32 picture_id, bool idr) {
+    for (auto& source : decoded) {
+        Picture picture;
+        picture.id = picture_id;
+        picture.idr = idr;
+        // Pictures are kept in the stream's coded size, with what the host decoder returned
+        // placed at the stream's crop window when it returned only that window.
+        u32 offset_x = 0, offset_y = 0;
+        picture.width = source.width;
+        picture.height = source.height;
+        if (sequence && sequence->coded_width >= source.width &&
+            sequence->coded_height >= source.height) {
+            picture.width = sequence->coded_width;
+            picture.height = sequence->coded_height;
+            if (source.width == sequence->crop_width && source.height == sequence->crop_height) {
+                offset_x = sequence->crop_left;
+                offset_y = sequence->crop_top;
+            }
+        }
+        if (picture.width == source.width && picture.height == source.height) {
+            picture.luma = std::move(source.luma);
+            picture.chroma = std::move(source.chroma);
+        } else {
+            const std::size_t chroma_width = (source.width + 1) / 2 * 2;
+            picture.luma.assign(std::size_t{picture.width} * picture.height, 16);
+            picture.chroma.assign(std::size_t{picture.width} * (picture.height / 2), 128);
+            for (u32 y = 0; y < source.height; ++y) {
+                std::memcpy(&picture.luma[std::size_t{y + offset_y} * picture.width + offset_x],
+                            &source.luma[std::size_t{y} * source.width], source.width);
+            }
+            for (u32 y = 0; y < (source.height + 1) / 2; ++y) {
+                std::memcpy(&picture.chroma[std::size_t{y + offset_y / 2} * picture.width +
+                                            (offset_x & ~1u)],
+                            &source.chroma[y * chroma_width], chroma_width);
+            }
+        }
+        if (pictures.size() == MaxQueuedPictures) {
+            LOG_WARNING(Service_MVD, "Dropping a decoded picture nobody has asked for");
+            pictures.pop_front();
+        }
+        pictures.push_back(std::move(picture));
+    }
+}
+
+void MVD_STD::ControlFrameRendering(Kernel::HLERequestContext& ctx) {
+    IPC::RequestParser rp(ctx);
+    const bool end_of_stream = rp.Pop<u8>() != 0;
+    rp.PopObject<Kernel::Process>();
+
+    IPC::RequestBuilder rb = rp.MakeBuilder(17, 0);
+    if (!h264_initialized) {
+        rb.Push<u32>(ErrorNotInitialized);
+        rb.PushRaw(std::array<u32, 16>{});
+        return;
+    }
+    if (end_of_stream && decoder) {
+        QueuePictures(decoder->Flush(), pictures.empty() ? 0 : pictures.back().id, false);
+    }
+    if (pictures.empty()) {
+        rb.Push<u32>(StatusOk);
+        rb.PushRaw(std::array<u32, 16>{});
+        return;
+    }
+
+    const Picture picture = std::move(pictures.front());
+    pictures.pop_front();
+    if (combined_mode) {
+        const SourceImage source{.width = picture.width,
+                                 .height = picture.height,
+                                 .luma = picture.luma,
+                                 .luma_stride = picture.width,
+                                 .chroma = picture.chroma,
+                                 .chroma_stride = picture.width,
+                                 .monochrome = sequence && sequence->monochrome};
+        std::optional<OutputBuffer> target;
+        if (!output_buffers.empty()) {
+            last_output_buffer = next_output_buffer;
+            target = output_buffers[next_output_buffer];
+            next_output_buffer = (next_output_buffer + 1) % output_buffers.size();
+        }
+        RunPostprocessor(source, target);
+    }
+    rb.Push<u32>(StatusPictureReady);
+    rb.PushRaw(PictureRecord(picture));
+}
+
+void MVD_STD::H264Peek(Kernel::HLERequestContext& ctx) {
+    IPC::RequestParser rp(ctx);
+    IPC::RequestBuilder rb = rp.MakeBuilder(17, 0);
+    if (pictures.empty()) {
+        rb.Push<u32>(h264_initialized ? StatusOk : ErrorNotInitialized);
+        rb.PushRaw(std::array<u32, 16>{});
+        return;
+    }
+    rb.Push<u32>(StatusPictureReady);
+    rb.PushRaw(PictureRecord(pictures.front()));
+}
+
+std::array<u32, 16> MVD_STD::PictureRecord(const Picture& picture) {
+    u32 vaddr = 0, paddr = 0;
+    StorePicture(picture, vaddr, paddr);
+    const bool cropped = sequence && sequence->coded_width == picture.width &&
+                         sequence->coded_height == picture.height;
+    return {picture.width,
+            picture.height,
+            cropped ? sequence->crop_left : 0,
+            cropped ? sequence->crop_width : picture.width,
+            cropped ? sequence->crop_top : 0,
+            cropped ? sequence->crop_height : picture.height,
+            vaddr,
+            paddr,
+            picture.id,
+            picture.idr ? 1u : 0u,
+            0,  // concealed macroblocks
+            0,  // interlaced
+            0,  // field picture
+            0,  // top field
+            0,  // MVC view
+            0}; // raster layout
+}
+
+void MVD_STD::StorePicture(const Picture& picture, u32& vaddr, u32& paddr) {
+    // The hardware decodes into the work buffer, and the picture record points there. Keep a
+    // copy at the same kind of place for clients that read the decoded picture directly.
+    const u32 picture_size =
+        Common::AlignUp(static_cast<u32>(picture.luma.size() + picture.chroma.size()), 0x100);
+    if (work_buffer_size <= WorkBufferHeader + picture_size) {
+        return;
+    }
+    const u32 slots = std::min<u32>((work_buffer_size - WorkBufferHeader) / picture_size, 18);
+    const u32 slot_vaddr =
+        work_buffer_vaddr + WorkBufferHeader + (next_work_slot % slots) * picture_size;
+    const auto slot_paddr = LinearToPhysical(slot_vaddr);
+    if (!slot_paddr || !memory.IsValidPhysicalAddress(*slot_paddr) ||
+        !memory.IsValidPhysicalAddress(*slot_paddr + picture_size - 1)) {
+        return;
+    }
+    next_work_slot = (next_work_slot + 1) % slots;
+    SyncRasterizer(*slot_paddr, picture_size, true);
+    u8* target = memory.GetPhysicalPointer(*slot_paddr);
+    std::memcpy(target, picture.luma.data(), picture.luma.size());
+    std::memcpy(target + picture.luma.size(), picture.chroma.data(), picture.chroma.size());
+    vaddr = slot_vaddr;
+    paddr = *slot_paddr;
+}
+
+void MVD_STD::GetStatus(Kernel::HLERequestContext& ctx) {
+    IPC::RequestParser rp(ctx);
+    IPC::RequestBuilder rb = rp.MakeBuilder(17, 0);
+    if (!h264_initialized || !sequence) {
+        rb.Push<u32>(h264_initialized ? ErrorHeadersNotReady : ErrorNotInitialized);
+        rb.PushRaw(std::array<u32, 16>{});
+        return;
+    }
+    const u32 picture_buffers = sequence->max_ref_frames + 1;
+    rb.Push<u32>(StatusOk);
+    rb.PushRaw(std::array<u32, 16>{
+        sequence->coded_width,
+        sequence->coded_height,
+        sequence->full_range ? 1u : 0u,
+        sequence->matrix_coefficients,
+        sequence->crop_left,
+        sequence->crop_width,
+        sequence->crop_top,
+        sequence->crop_height,
+        static_cast<u32>(sequence->monochrome ? PixelFormat::YCbCr400
+                                              : PixelFormat::YCbCr420Semiplanar),
+        sequence->sar_width,
+        sequence->sar_height,
+        sequence->monochrome ? 1u : 0u,
+        sequence->interlaced ? 1u : 0u,
+        0, // frame DPB mode
+        picture_buffers,
+        picture_buffers + 1,
+    });
+}
+
+void MVD_STD::PpInitialize(Kernel::HLERequestContext& ctx) {
+    IPC::RequestParser rp(ctx);
+    // Hantro's postprocessor defaults.
+    config = {};
+    config.input_format = PixelFormat::YCbCr420Semiplanar;
+    config.input_width = 720;
+    config.input_height = 576;
+    config.output_format = PixelFormat::Rgb32;
+    config.rgb_transform = 1;
+    config.coefficients = {298, 409, 208, 100, 516};
+    postprocessor_initialized = true;
+
+    IPC::RequestBuilder rb = rp.MakeBuilder(1, 0);
+    rb.Push<u32>(initialized ? StatusOk : ErrorNotInitialized);
+}
+
+void MVD_STD::PpRelease(Kernel::HLERequestContext& ctx) {
+    IPC::RequestParser rp(ctx);
+    postprocessor_initialized = combined_mode = false;
+    output_buffers.clear();
+    last_output_buffer.reset();
+
+    IPC::RequestBuilder rb = rp.MakeBuilder(1, 0);
+    rb.Push<u32>(0);
+}
+
+void MVD_STD::PpGetResult(Kernel::HLERequestContext& ctx) {
+    IPC::RequestParser rp(ctx);
+    IPC::RequestBuilder rb = rp.MakeBuilder(1, 0);
+    if (!postprocessor_initialized) {
+        rb.Push<u32>(ErrorNotInitialized);
+        return;
+    }
+    if (combined_mode) {
+        // Only reports the result of the last decode-and-convert, which always succeeds here.
+        rb.Push<u32>(StatusOk);
+        return;
+    }
+
+    // Standalone color conversion of the configured input.
+    if (const u32 error = ValidateConfig(config, false)) {
+        rb.Push<u32>(error);
+        return;
+    }
+    const auto sizes =
+        StandaloneInputSizes(config.input_format, config.input_width, config.input_height);
+    std::array<std::span<const u8>, 3> planes;
+    const std::array<u32, 3> addresses{config.input_paddr, config.input_cb_paddr,
+                                       config.input_cr_paddr};
+    for (std::size_t i = 0; i < planes.size(); ++i) {
+        if (sizes[i] == 0) {
+            continue;
+        }
+        if (!memory.IsValidPhysicalAddress(addresses[i]) ||
+            !memory.IsValidPhysicalAddress(addresses[i] + static_cast<u32>(sizes[i]) - 1)) {
+            LOG_ERROR(Service_MVD, "Invalid input address 0x{:08X}", addresses[i]);
+            rb.Push<u32>(ErrorParameter);
+            return;
+        }
+        SyncRasterizer(addresses[i], static_cast<u32>(sizes[i]), false);
+        planes[i] = {memory.GetPhysicalPointer(addresses[i]), sizes[i]};
+    }
+    const auto input = LoadStandaloneInput(config.input_format, config.input_width,
+                                           config.input_height, planes[0], planes[1], planes[2]);
+    if (!input) {
+        rb.Push<u32>(ErrorParameter);
+        return;
+    }
+    rb.Push<u32>(RunPostprocessor(input->image, std::nullopt));
+}
+
+void MVD_STD::PpEnableCombinedMode(Kernel::HLERequestContext& ctx) {
+    IPC::RequestParser rp(ctx);
+    const u8 decoder_type = rp.Pop<u8>();
+
+    IPC::RequestBuilder rb = rp.MakeBuilder(1, 0);
+    switch (decoder_type) {
+    case 1: // H.264
+        combined_mode = true;
+        rb.Push<u32>(StatusOk);
+        break;
+    case 6:  // VP6
+    case 9:  // VP8
+    case 10: // WebP
+        // Accepted, but with an H.264 decoder the hardware then produces no output.
+        combined_mode = false;
+        rb.Push<u32>(StatusOk);
+        break;
+    default:
+        rb.Push<u32>(ErrorParameter);
+        break;
+    }
+}
+
+void MVD_STD::PpDisableCombinedMode(Kernel::HLERequestContext& ctx) {
+    IPC::RequestParser rp(ctx);
+    combined_mode = false;
+    IPC::RequestBuilder rb = rp.MakeBuilder(1, 0);
+    rb.Push<u32>(StatusOk);
+}
+
+void MVD_STD::GetConfig(Kernel::HLERequestContext& ctx) {
+    IPC::RequestParser rp(ctx);
+    rp.Pop<u32>(); // size; the service always copies the whole configuration
+    auto& buffer = rp.PopMappedBuffer();
+    buffer.Write(&config, 0, std::min(sizeof(config), buffer.GetSize()));
+
+    IPC::RequestBuilder rb = rp.MakeBuilder(1, 2);
+    rb.Push<u32>(StatusOk);
+    rb.PushMappedBuffer(buffer);
+}
+
+void MVD_STD::SetConfig(Kernel::HLERequestContext& ctx) {
+    IPC::RequestParser rp(ctx);
+    rp.Pop<u32>(); // size; the service always copies the whole configuration
+    rp.PopObject<Kernel::Process>();
+    auto& buffer = rp.PopMappedBuffer();
+    PostprocessorConfig incoming{};
+    buffer.Read(&incoming, 0, std::min(sizeof(incoming), buffer.GetSize()));
+
+    // A rejected configuration leaves the current one in place.
+    const u32 error = ValidateConfig(incoming, combined_mode);
+    if (error == 0) {
+        config = incoming;
+    } else {
+        LOG_DEBUG(Service_MVD, "rejected configuration: 0x{:08X}", error);
+    }
+    IPC::RequestBuilder rb = rp.MakeBuilder(1, 2);
+    rb.Push<u32>(error == 0 ? StatusOk : error);
+    rb.PushMappedBuffer(buffer);
+}
+
+void MVD_STD::SetupOutputBuffers(Kernel::HLERequestContext& ctx) {
+    IPC::RequestParser rp(ctx);
+    const u32 count = rp.Pop<u32>();
+    std::array<std::array<u32, 2>, MaxOutputBuffers> entries;
+    for (auto& entry : entries) {
+        entry[0] = rp.Pop<u32>();
+        entry[1] = rp.Pop<u32>();
+    }
+    rp.Pop<u32>(); // size of each buffer
+    rp.PopObject<Kernel::Process>();
+
+    IPC::RequestBuilder rb = rp.MakeBuilder(1, 0);
+    if (!combined_mode) {
+        rb.Push<u32>(ErrorCombinedMode);
+        return;
+    }
+    if (count == 0 || count > MaxOutputBuffers) {
+        rb.Push<u32>(ErrorParameter);
+        return;
+    }
+    std::vector<OutputBuffer> buffers;
+    for (u32 i = 0; i < count; ++i) {
+        const auto paddr = LinearToPhysical(entries[i][0]);
+        const auto chroma_paddr =
+            entries[i][1] != 0 ? LinearToPhysical(entries[i][1]) : std::optional<PAddr>{0};
+        if (entries[i][0] == 0 || !paddr || !chroma_paddr) {
+            rb.Push<u32>(ErrorParameter);
+            return;
+        }
+        buffers.push_back({entries[i][0], entries[i][1], *paddr, *chroma_paddr});
+    }
+    output_buffers = std::move(buffers);
+    next_output_buffer = 0;
+    last_output_buffer.reset();
+    rb.Push<u32>(StatusOk);
+}
+
+void MVD_STD::GetNextOutput(Kernel::HLERequestContext& ctx) {
+    IPC::RequestParser rp(ctx);
+    rp.PopObject<Kernel::Process>();
+
+    IPC::RequestBuilder rb = rp.MakeBuilder(3, 0);
+    rb.Push<u32>(StatusOk);
+    if (last_output_buffer && *last_output_buffer < output_buffers.size()) {
+        rb.Push<u32>(output_buffers[*last_output_buffer].vaddr);
+        rb.Push<u32>(output_buffers[*last_output_buffer].chroma_vaddr);
+    } else {
+        rb.Push<u32>(0);
+        rb.Push<u32>(0);
+    }
+}
+
+void MVD_STD::OverrideOutputBuffers(Kernel::HLERequestContext& ctx) {
+    IPC::RequestParser rp(ctx);
+    const u32 current = rp.Pop<u32>();
+    const u32 current_chroma = rp.Pop<u32>();
+    const u32 replacement = rp.Pop<u32>();
+    const u32 replacement_chroma = rp.Pop<u32>();
+
+    IPC::RequestBuilder rb = rp.MakeBuilder(1, 0);
+    const auto entry = std::ranges::find_if(output_buffers, [&](const OutputBuffer& buffer) {
+        return buffer.vaddr == current && buffer.chroma_vaddr == current_chroma;
+    });
+    const auto paddr = LinearToPhysical(replacement);
+    const auto chroma_paddr =
+        replacement_chroma != 0 ? LinearToPhysical(replacement_chroma) : std::optional<PAddr>{0};
+    if (entry == output_buffers.end() || !paddr || !chroma_paddr) {
+        rb.Push<u32>(ErrorParameter);
+        return;
+    }
+    *entry = {replacement, replacement_chroma, *paddr, *chroma_paddr};
+    rb.Push<u32>(StatusOk);
+}
+
+u32 MVD_STD::RunPostprocessor(const SourceImage& source, std::optional<OutputBuffer> target) {
+    PostprocessorConfig effective = config;
+    if (target) {
+        effective.output_paddr = target->paddr;
+        effective.output_chroma_paddr = target->chroma_paddr;
+    }
+    const OutputLayout layout = GetOutputLayout(effective);
+    const auto map = [&](PAddr address, std::size_t size) -> std::span<u8> {
+        if (size == 0) {
+            return {};
+        }
+        if (!memory.IsValidPhysicalAddress(address) ||
+            !memory.IsValidPhysicalAddress(address + static_cast<u32>(size) - 1)) {
+            LOG_ERROR(Service_MVD, "Invalid output address 0x{:08X} (0x{:X} bytes)", address, size);
+            return {};
+        }
+        SyncRasterizer(address, static_cast<u32>(size), true);
+        return {memory.GetPhysicalPointer(address), size};
+    };
+    const OutputPlanes planes{map(effective.output_paddr, layout.plane_size),
+                              map(effective.output_chroma_paddr, layout.chroma_size)};
+    if (planes.plane.size() != layout.plane_size || planes.chroma.size() != layout.chroma_size) {
+        return ErrorParameter;
+    }
+    Postprocess(source, effective, planes);
+    return StatusOk;
+}
+
+void MVD_STD::SyncRasterizer(PAddr address, u32 size, bool invalidate) {
+    // Before reading memory the GPU may have written, flush it; before writing memory the GPU may
+    // have cached, also invalidate it. Without a running system (unit tests) there is no GPU.
+    if (!system.IsPoweredOn()) {
+        return;
+    }
+    auto* rasterizer = system.GPU().Renderer().Rasterizer();
+    if (invalidate) {
+        rasterizer->FlushAndInvalidateRegion(address, size);
+    } else {
+        rasterizer->FlushRegion(address, size);
+    }
+}
+
+std::optional<PAddr> MVD_STD::LinearToPhysical(VAddr address) {
+    if (address >= Memory::NEW_LINEAR_HEAP_VADDR && address < Memory::NEW_LINEAR_HEAP_VADDR_END) {
+        return Memory::FCRAM_PADDR + (address - Memory::NEW_LINEAR_HEAP_VADDR);
+    }
+    if (address >= Memory::LINEAR_HEAP_VADDR && address < Memory::LINEAR_HEAP_VADDR_END) {
+        return Memory::FCRAM_PADDR + (address - Memory::LINEAR_HEAP_VADDR);
+    }
+    return std::nullopt;
+}
+
+void MVD_STD::ResetDecoder() {
+    if (!decoder) {
+        decoder = CreateH264Decoder();
+    }
+    if (decoder) {
+        decoder->Reset();
+    }
+    pictures.clear();
+    sequence.reset();
+    active_sps.clear();
+    active_pps.clear();
+    headers_pending = false;
+}
 
 } // namespace Service::MVD
