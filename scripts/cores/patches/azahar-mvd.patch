+TEST_CASE("MVD postprocessor rejects configurations like the hardware", "[service][mvd]") {
+    const auto valid = VideoConfig(400, 240, PixelFormat::Rgb16_565);
+    REQUIRE(ValidateConfig(valid, true) == 0);
+
+    auto config = valid;
+    config.input_width = 40; // video needs at least 48
+    REQUIRE(ValidateConfig(config, true) == 0xD9617108);
+    config = valid;
+    config.input_format = PixelFormat::YCbCr422Interleaved; // not from the decoder
+    REQUIRE(ValidateConfig(config, true) == 0xD961710A);
+    config = valid;
+    config.crop_enable = 1;
+    config.crop_x = 8; // crop origin must be a multiple of 16
+    config.crop_width = 240;
+    config.crop_height = 240;
+    REQUIRE(ValidateConfig(config, true) == 0xD961710B);
+    config = valid;
+    config.rotation = 6;
+    REQUIRE(ValidateConfig(config, true) == 0xD961710C);
+    config = valid;
+    config.output_width = 8;
+    REQUIRE(ValidateConfig(config, true) == 0xD961710D);
+    config = valid;
+    config.output_width = 1201; // more than 3x upscaling
+    REQUIRE(ValidateConfig(config, true) == 0xD961710D);
+    config = valid;
+    config.output_paddr = 0x20000004; // must be 8-byte aligned
+    REQUIRE(ValidateConfig(config, true) == 0xD961710E);
+    config = valid;
+    config.output_format = PixelFormat::YCbCr420Planar;
+    REQUIRE(ValidateConfig(config, true) == 0xD961710F);
+    config = valid;
+    config.saturation = 200;
+    REQUIRE(ValidateConfig(config, true) == 0xD9617110);
+    config = valid;
+    config.output_format = PixelFormat::Rgb16Custom;
+    config.mask_r = 0xF800;
+    config.mask_g = 0x0FE0; // overlaps red
+    REQUIRE(ValidateConfig(config, true) == 0xD9617111);
+    config = valid;
+    config.frame_buffer_enable = 1;
+    config.frame_buffer_width = 400;
+    config.frame_buffer_height = 240;
+    config.frame_buffer_x = 400; // entirely outside
+    REQUIRE(ValidateConfig(config, true) == 0xD9617112);
+
+    // Standalone conversion: 16-pixel alignment and an input address.
+    auto standalone = VideoConfig(400, 240, PixelFormat::Rgb16_565);
+    standalone.input_format = PixelFormat::YCbCr422Interleaved;
+    standalone.input_paddr = 0x22000000;
+    REQUIRE(ValidateConfig(standalone, false) == 0);
+    standalone.input_width = 408;
+    REQUIRE(ValidateConfig(standalone, false) == 0xD9617108);
+    standalone.input_width = 400;
+    standalone.input_paddr = 0;
+    REQUIRE(ValidateConfig(standalone, false) == 0xD9617109);
+}
+
+TEST_CASE("MVD postprocessor reads standalone inputs", "[service][mvd]") {
+    // A YUYV image converted to YUYV comes back unchanged.
+    std::vector<u8> yuyv(16 * 16 * 2);
+    for (std::size_t i = 0; i < yuyv.size(); ++i) {
+        yuyv[i] = static_cast<u8>(i % 4 == 1 || i % 4 == 3 ? 100 + (i / 4) % 50 : 20 + i % 200);
+    }
+    const auto input = LoadStandaloneInput(PixelFormat::YCbCr422Interleaved, 16, 16, yuyv, {}, {});
+    REQUIRE(input);
+    auto config = VideoConfig(16, 16, PixelFormat::YCbCr422Interleaved);
+    config.input_format = PixelFormat::YCbCr422Interleaved;
+    REQUIRE(Run(input->image, config) == yuyv);
+
+    REQUIRE_FALSE(LoadStandaloneInput(PixelFormat::Rgb16_565, 16, 16, yuyv, {}, {}));
+    REQUIRE_FALSE(LoadStandaloneInput(PixelFormat::YCbCr422Interleaved, 16, 16,
+                                      std::span<const u8>(yuyv).first(10), {}, {}));
+}
