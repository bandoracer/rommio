+void MVD_STD::CalculateWorkBufSize(Kernel::HLERequestContext& ctx) {
+    IPC::RequestParser rp(ctx);
+    std::array<u8, 12> bytes;
+    for (std::size_t word = 0; word < 3; ++word) {
+        const u32 value = rp.Pop<u32>();
+        std::memcpy(bytes.data() + word * 4, &value, sizeof(value));
+    }
+    rp.Skip(7, false);
+    const u32 width = rp.Pop<u32>();
+    const u32 height = rp.Pop<u32>();
+
+    const u64 macroblocks = u64{(width + 15) / 16} * ((height + 15) / 16);
+    const u64 frame_size = 384 * macroblocks;
+    u64 size = 0;
+    // Estimate from the H.264 level: as many reference frames as its DPB holds.
+    if (bytes[1] && macroblocks != 0 && bytes[4] < max_dpb_mbs.size()) {
+        const u64 references = std::min<u64>(max_dpb_mbs[bytes[4]] / macroblocks, 16);
+        u64 level_size = frame_size * (references + 1);
+        if (bytes[2] & 6) {
+            level_size += level_size / 6;
+        }
+        if (bytes[3]) {
+            level_size *= 2;
+        }
+        size = std::max(size, level_size + 0xFC8);
+    }
+    // Estimates from a reference frame count.
+    if (bytes[5]) {
+        size = std::max<u64>(size, frame_size * std::clamp<u32>(bytes[6], 2, 16) + 0x10800);
+    }
+    if (bytes[7]) {
+        size = std::max<u64>(size, frame_size * std::clamp<u32>(bytes[8], 2, 16) + 0x858);
+    }
+
+    IPC::RequestBuilder rb = rp.MakeBuilder(2, 0);
+    rb.Push<u32>(0);
+    rb.Push<u32>(static_cast<u32>(std::min<u64>(size, 0xFFFFFFFF)));
+    LOG_DEBUG(Service_MVD, "called, {}x{} -> 0x{:X}", width, height, size);
+}
+
+void MVD_STD::CalculateImageSize(Kernel::HLERequestContext& ctx) {
+    IPC::RequestParser rp(ctx);
+    const u32 word1 = rp.Pop<u32>();
+    const u32 word2 = rp.Pop<u32>();
+    const u32 word3 = rp.Pop<u32>();
+
+    const auto bytes_per_pixel = [](u32 format) -> u32 {
+        switch (format) {
+        case 0x00010001:
+        case 0x00040002:
+            return 2;
+        case 0x00041002:
+            return 4;
+        default:
+            return 0;
+        }
+    };
+    // The width and height come first, then the format (3dbrew lists the format first; its
+    // values 2 and 6 and 0x1006 are accepted in that position too).
+    u32 width = word1, height = word2, pixel_size = bytes_per_pixel(word3);
+    if (pixel_size == 0) {
+        width = word2, height = word3;
+        pixel_size = (word1 == 2 || word1 == 6) ? 2 : (word1 == 0x1006 ? 4 : 0);
+    }
+    IPC::RequestBuilder rb = rp.MakeBuilder(2, 0);
+    if (pixel_size == 0) {
+        LOG_ERROR(Service_MVD, "unknown pixel format in ({:X}, {:X}, {:X})", word1, word2, word3);
+        rb.Push<u32>(ErrorParameter);
+        rb.Push<u32>(0);
+        return;
+    }
+    rb.Push<u32>(0);
+    rb.Push<u32>(std::min(width, 1920u) * std::min(height, 1920u) * pixel_size);
+}
+
+void MVD_STD::H264Initialize(Kernel::HLERequestContext& ctx) {
+    IPC::RequestParser rp(ctx);
+    const auto no_reordering = static_cast<s8>(rp.Pop<u8>());
+    const auto freeze_concealment = static_cast<s8>(rp.Pop<u8>());
+    const auto display_smoothing = static_cast<s8>(rp.Pop<u8>());
+    const auto reference_format = rp.Pop<u32>();
+
+    h264_initialized = true;
+    ResetDecoder();
+
+    IPC::RequestBuilder rb = rp.MakeBuilder(1, 0);
+    rb.Push<u32>(initialized ? StatusOk : ErrorNotInitialized);
+    LOG_DEBUG(Service_MVD, "called, no_reordering={} freeze_concealment={} smoothing={} ref=0x{:X}",
+              no_reordering, freeze_concealment, display_smoothing, reference_format);
+}
