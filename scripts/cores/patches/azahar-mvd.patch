@@ -0,0 +1,354 @@
+// Copyright 2026 Azahar Emulator Project
+// Licensed under GPLv2 or any later version
+// Refer to the license.txt file included.
+
+#include <cstring>
+#include <vector>
+#include <catch2/catch_test_macros.hpp>
+#include "core/core.h"
+#include "core/core_timing.h"
+#include "core/hle/ipc.h"
+#include "core/hle/kernel/hle_ipc.h"
+#include "core/hle/kernel/process.h"
+#include "core/hle/kernel/server_session.h"
+#include "core/hle/service/mvd/mvd_std.h"
+#include "core/memory.h"
+#include "tests/core/hle/service/mvd/test_stream.h"
+
+using namespace Service::MVD;
+using MvdTest::height;
+using MvdTest::width;
+
+namespace {
+
+// Where the client keeps things, as linear-memory virtual and physical addresses.
+constexpr VAddr WorkBuffer = 0x30100000;
+constexpr u32 WorkBufferSize = 0x9006C8;
+constexpr VAddr Input = 0x31000000;
+constexpr PAddr InputPhysical = 0x21000000;
+constexpr PAddr Output = 0x21100000;
+constexpr VAddr ConfigBuffer = 0x10000000;
+
+/// mvd:STD driven the way libctru's client drives it.
+class MvdClient {
+public:
+    MvdClient() {
+        process->handle_table.Create(std::addressof(process_handle), process);
+        config_memory = std::make_shared<BufferMem>(Memory::CITRA_PAGE_SIZE);
+        REQUIRE(process->vm_manager
+                    .MapBackingMemory(ConfigBuffer, MemoryRef{config_memory},
+                                      Memory::CITRA_PAGE_SIZE, Kernel::MemoryState::Private)
+                    .Code() == ResultSuccess);
+    }
+
+    std::vector<u32> Call(std::vector<u32> request, std::size_t reply_words) {
+        auto [server, client] = kernel.CreateSessionPair();
+        Kernel::HLERequestContext context(kernel, std::move(server), nullptr);
+        context.PopulateFromIncomingCommandBuffer(request.data(), process);
+        service->HandleSyncRequest(context);
+        const u32* reply = context.CommandBuffer();
+        return std::vector<u32>(reply + 1, reply + 1 + reply_words);
+    }
+
+    u32 Initialize() {
+        return Call({IPC::MakeHeader(0x1, 2, 2), WorkBuffer, WorkBufferSize, IPC::CopyHandleDesc(),
+                     process_handle},
+                    1)[0];
+    }
+
+    /// Initialize, H264Initialize, PpInitialize and PpEnableCombinedMode(H.264), as mvdstdInit.
+    void InitializeVideo() {
+        REQUIRE(Initialize() == 0);
+        REQUIRE(Call({IPC::MakeHeader(0x5, 4, 0), 0, 0, 0, 0}, 1)[0] == 0x17000);
+        REQUIRE(Call({IPC::MakeHeader(0x18, 0, 0)}, 1)[0] == 0x17000);
+        REQUIRE(Call({IPC::MakeHeader(0x1B, 1, 0), 1}, 1)[0] == 0x17000);
+    }
+
+    /// ProcessNALUnit: returns {status, end vaddr, end paddr, remaining}.
+    std::vector<u32> ProcessNalUnit(std::span<const u8> data, u32 picture_id, bool skip = false) {
+        std::memcpy(memory.GetPhysicalPointer(InputPhysical), data.data(), data.size());
+        return Call({IPC::MakeHeader(0x8, 5, 2), Input, InputPhysical,
+                     static_cast<u32>(data.size()), picture_id, skip ? 1u : 0u,
+                     IPC::CopyHandleDesc(), process_handle},
+                    4);
+    }
+
+    /// ControlFrameRendering: returns the status and the 16-word picture record.
+    std::vector<u32> NextPicture(bool end_of_stream = false) {
+        return Call({IPC::MakeHeader(0x9, 1, 2), end_of_stream ? 1u : 0u, IPC::CopyHandleDesc(),
+                     process_handle},
+                    17);
+    }
+
+    u32 SetConfig(const PostprocessorConfig& config) {
+        std::memcpy(config_memory->GetPtr(), &config, sizeof(config));
+        return Call({IPC::MakeHeader(0x1E, 1, 4), sizeof(config), IPC::CopyHandleDesc(),
+                     process_handle, IPC::MappedBufferDesc(sizeof(config), IPC::R), ConfigBuffer},
+                    1)[0];
+    }
+
+    PostprocessorConfig GetConfig() {
+        std::memset(config_memory->GetPtr(), 0, sizeof(PostprocessorConfig));
+        REQUIRE(Call({IPC::MakeHeader(0x1D, 1, 2), sizeof(PostprocessorConfig),
+                      IPC::MappedBufferDesc(sizeof(PostprocessorConfig), IPC::W), ConfigBuffer},
+                     1)[0] == 0x17000);
+        PostprocessorConfig config;
+        std::memcpy(&config, config_memory->GetPtr(), sizeof(config));
+        return config;
+    }
+
+    Core::Timing timing{1, 100};
+    Core::System system;
+    Memory::MemorySystem memory{system};
+    Kernel::KernelSystem kernel{memory, timing, [] {}, Kernel::MemoryMode::NewProd, 1};
+    std::shared_ptr<Kernel::Process> process = kernel.CreateProcess(kernel.CreateCodeSet("", 0));
+    Kernel::Handle process_handle{};
+    std::shared_ptr<BufferMem> config_memory;
+    std::shared_ptr<MVD_STD> service = std::make_shared<MVD_STD>(system, memory);
+};
+
+/// The configuration SKATER and libctru's examples use for video: decoder input, RGB565 out.
+PostprocessorConfig VideoConfig(u32 picture_width, u32 picture_height) {
+    PostprocessorConfig config{};
+    config.input_format = PixelFormat::YCbCr420Semiplanar;
+    config.input_width = picture_width;
+    config.input_height = picture_height;
+    config.crop_enable = 1;
+    config.crop_width = picture_width;
+    config.crop_height = picture_height;
+    config.output_format = PixelFormat::Rgb16_565;
+    config.output_width = picture_width;
+    config.output_height = picture_height;
+    config.output_paddr = Output;
+    config.rgb_transform = 1;
+    return config;
+}
+
+/// The reference picture converted with the documented BT.601 limited-range coefficients.
+std::vector<u16> ExpectedRgb565(std::span<const u8> luma, std::span<const u8> chroma) {
+    std::vector<u16> pixels;
+    for (u32 y = 0; y < height; ++y) {
+        for (u32 x = 0; x < width; ++x) {
+            const int luma_term = 298 * (luma[y * width + x] - 16);
+            const int cb = chroma[(y / 2) * width + (x / 2) * 2] - 128;
+            const int cr = chroma[(y / 2) * width + (x / 2) * 2 + 1] - 128;
+            const auto channel = [](int value) { return std::clamp((value + 128) >> 8, 0, 255); };
+            const int r = channel(luma_term + 409 * cr);
+            const int g = channel(luma_term - 208 * cr - 100 * cb);
+            const int b = channel(luma_term + 516 * cb);
+            pixels.push_back(static_cast<u16>((r >> 3) << 11 | (g >> 2) << 5 | b >> 3));
+        }
+    }
+    return pixels;
+}
+
+std::vector<u16> ReadRgb565(Memory::MemorySystem& memory, PAddr address, std::size_t count) {
+    std::vector<u16> pixels(count);
+    std::memcpy(pixels.data(), memory.GetPhysicalPointer(address), count * 2);
+    return pixels;
+}
+
+} // namespace
+
+TEST_CASE("mvd:STD has the real service name", "[service][mvd]") {
+    MvdClient client;
+    REQUIRE(client.service->GetServiceName() == "mvd:STD");
+}
+
+TEST_CASE("mvd:STD calculates the browser's work buffer size", "[service][mvd]") {
+    MvdClient client;
+    // 854x480 at level 3.2 with the level estimate's extra-op flag: 3dbrew's 0x9006C8.
+    std::vector<u32> request(13, 0);
+    request[0] = IPC::MakeHeader(0x3, 12, 0);
+    request[1] = 0x0002'0100; // bytes 1..2: level estimate enabled, flag 2
+    request[2] = 0x0000'000A; // byte 4: level 3.2
+    request[11] = 854;
+    request[12] = 480;
+    const auto reply = client.Call(request, 2);
+    REQUIRE(reply[0] == 0);
+    REQUIRE(reply[1] == 0x9006C8);
+}
+
+TEST_CASE("mvd:STD decodes H.264 into the configured output", "[service][mvd]") {
+    MvdClient client;
+    if (!CreateH264Decoder()) {
+        SKIP("No H.264 decoder on this platform");
+    }
+    client.InitializeVideo();
+    const auto units = MvdTest::SplitAnnexB(MvdTest::stream);
+
+    // Before any stream headers there is no information.
+    REQUIRE(client.Call({IPC::MakeHeader(0xA, 0, 0)}, 17)[0] == 0xD96170CE);
+
+    // Parameter sets and SEI are consumed without a picture.
+    for (std::size_t i = 0; i < 3; ++i) {
+        const auto reply = client.ProcessNalUnit(units[i], 0);
+        REQUIRE(reply[0] == 0x17001);
+        REQUIRE(reply[2] == InputPhysical + units[i].size());
+        REQUIRE(reply[3] == 0);
+    }
+
+    // The first slice of the new sequence stops for the headers and isn't consumed.
+    auto reply = client.ProcessNalUnit(units[3], 0);
+    REQUIRE(reply[0] == 0x17004);
+    REQUIRE(reply[3] == units[3].size());
+    const auto info = client.Call({IPC::MakeHeader(0xA, 0, 0)}, 17);
+    REQUIRE(info[0] == 0x17000);
+    REQUIRE(info[1] == width);
+    REQUIRE(info[2] == height);
+    REQUIRE(info[6] == width);                   // crop width
+    REQUIRE(info[8] == height);                  // crop height
+    REQUIRE(info[9] == 0x00020001);              // NV12 output from the decoder
+    REQUIRE(client.NextPicture()[0] == 0x17000); // nothing decoded yet
+
+    REQUIRE(client.SetConfig(VideoConfig(width, height)) == 0x17000);
+    for (u32 picture = 0; picture < 3; ++picture) {
+        reply = client.ProcessNalUnit(units[3 + picture], picture + 5);
+        REQUIRE(reply[0] == 0x17003);
+        REQUIRE(reply[3] == 0);
+
+        const auto record = client.NextPicture();
+        REQUIRE(record[0] == 0x17002);
+        REQUIRE(record[1] == width);
+        REQUIRE(record[2] == height);
+        REQUIRE(record[9] == picture + 5);     // picture ID
+        REQUIRE(record[10] == (picture == 0)); // IDR
+
+        // The decoded picture is in the work buffer where the record says.
+        const PAddr decoded = record[8];
+        REQUIRE(decoded >= 0x20100000);
+        const u8* nv12 = client.memory.GetPhysicalPointer(decoded);
+        const std::span<const u8> luma(nv12, width * height),
+            chroma(nv12 + width * height, width * height / 2);
+        REQUIRE(MvdTest::Fnv1a(luma, chroma) == MvdTest::expected_pictures[picture]);
+
+        // And converted into the configured RGB565 surface.
+        REQUIRE(ReadRgb565(client.memory, Output, width * height) == ExpectedRgb565(luma, chroma));
+
+        // Only one picture per decode.
+        REQUIRE(client.NextPicture()[0] == 0x17000);
+    }
+    // Draining at the end of the stream returns nothing more.
+    REQUIRE(client.NextPicture(true)[0] == 0x17000);
+}
+
+TEST_CASE("mvd:STD accepts a whole access unit per call", "[service][mvd]") {
+    MvdClient client;
+    if (!CreateH264Decoder()) {
+        SKIP("No H.264 decoder on this platform");
+    }
+    client.InitializeVideo();
+    REQUIRE(client.SetConfig(VideoConfig(width, height)) == 0x17000);
+    const auto units = MvdTest::SplitAnnexB(MvdTest::stream);
+
+    // SPS, PPS, SEI and the IDR slice in one buffer: stops at the slice for the headers, and the
+    // remainder passed again decodes it (video players send their first packet twice for this).
+    const std::span<const u8> first(units[0].data(),
+                                    units[3].data() + units[3].size() - units[0].data());
+    auto reply = client.ProcessNalUnit(first, 1);
+    REQUIRE(reply[0] == 0x17004);
+    REQUIRE(reply[3] == units[3].size());
+    reply = client.ProcessNalUnit(first.last(reply[3]), 1);
+    REQUIRE(reply[0] == 0x17003);
+    REQUIRE(client.NextPicture()[0] == 0x17002);
+}
+
+TEST_CASE("mvd:STD skips non-reference pictures on request", "[service][mvd]") {
+    MvdClient client;
+    if (!CreateH264Decoder()) {
+        SKIP("No H.264 decoder on this platform");
+    }
+    client.InitializeVideo();
+    const auto units = MvdTest::SplitAnnexB(MvdTest::stream);
+    for (std::size_t i = 0; i < 3; ++i) {
+        client.ProcessNalUnit(units[i], 0);
+    }
+    client.ProcessNalUnit(units[3], 0); // headers ready
+    REQUIRE(client.ProcessNalUnit(units[3], 0)[0] == 0x17003);
+
+    // A reference picture is decoded even when skipping is requested.
+    REQUIRE(client.ProcessNalUnit(units[4], 1, true)[0] == 0x17003);
+    // The same slice marked as a non-reference picture (nal_ref_idc 0) is skipped.
+    std::vector<u8> non_reference(units[5].begin(), units[5].end());
+    non_reference[3] &= 0x9F;
+    const auto reply = client.ProcessNalUnit(non_reference, 2, true);
+    REQUIRE(reply[0] == 0x17007);
+    REQUIRE(reply[3] == 0);
+    REQUIRE(client.NextPicture()[0] == 0x17002); // the IDR picture
+    REQUIRE(client.NextPicture()[0] == 0x17002); // the reference P picture
+    REQUIRE(client.NextPicture()[0] == 0x17000); // nothing for the skipped one
+}
+
+TEST_CASE("mvd:STD writes each picture to the next multibuffer output", "[service][mvd]") {
+    MvdClient client;
+    if (!CreateH264Decoder()) {
+        SKIP("No H.264 decoder on this platform");
+    }
+    client.InitializeVideo();
+    REQUIRE(client.SetConfig(VideoConfig(width, height)) == 0x17000);
+
+    std::vector<u32> request(39, 0);
+    request[0] = IPC::MakeHeader(0x1F, 36, 2);
+    request[1] = 2;
+    request[2] = 0x31200000; // buffer 0
+    request[4] = 0x31300000; // buffer 1
+    request[36] = width * height * 2;
+    request[37] = IPC::CopyHandleDesc();
+    request[38] = client.process_handle;
+    REQUIRE(client.Call(request, 1)[0] == 0x17000);
+
+    const auto units = MvdTest::SplitAnnexB(MvdTest::stream);
+    for (std::size_t i = 0; i < 3; ++i) {
+        client.ProcessNalUnit(units[i], 0);
+    }
+    client.ProcessNalUnit(units[3], 0); // headers ready
+    for (u32 picture = 0; picture < 2; ++picture) {
+        REQUIRE(client.ProcessNalUnit(units[3 + picture], picture)[0] == 0x17003);
+        REQUIRE(client.NextPicture()[0] == 0x17002);
+        const auto next = client.Call(
+            {IPC::MakeHeader(0x20, 0, 2), IPC::CopyHandleDesc(), client.process_handle}, 3);
+        REQUIRE(next[1] == (picture == 0 ? 0x31200000u : 0x31300000u));
+    }
+    // Both buffers hold a picture; the configured output was not written.
+    const u8* first = client.memory.GetPhysicalPointer(0x21200000);
+    const u8* second = client.memory.GetPhysicalPointer(0x21300000);
+    REQUIRE(std::memcmp(first, second, width * height * 2) != 0);
+    REQUIRE(ReadRgb565(client.memory, Output, 4) == std::vector<u16>(4, 0));
+}
+
+TEST_CASE("mvd:STD keeps its configuration and rejects invalid ones", "[service][mvd]") {
+    MvdClient client;
+    client.InitializeVideo();
+    // Hantro's defaults after PpInitialize.
+    auto config = client.GetConfig();
+    REQUIRE(config.input_width == 720);
+    REQUIRE(config.output_format == PixelFormat::Rgb32);
+
+    REQUIRE(client.SetConfig(VideoConfig(400, 240)) == 0x17000);
+    config = client.GetConfig();
+    REQUIRE(config.input_width == 400);
+    REQUIRE(config.output_paddr == Output);
+
+    auto invalid = VideoConfig(400, 240);
+    invalid.output_width = 8;
+    REQUIRE(client.SetConfig(invalid) == 0xD961710D);
+    REQUIRE(client.GetConfig().output_width == 400); // unchanged
+}
+
+TEST_CASE("mvd:STD answers the commands libctru's init and exit check", "[service][mvd]") {
+    MvdClient client;
+    REQUIRE(client.Initialize() == 0);
+    REQUIRE(client.Call({IPC::MakeHeader(0x5, 4, 0), 0, 0, 0, 0}, 1)[0] == 0x17000);
+    REQUIRE(client.Call({IPC::MakeHeader(0x18, 0, 0)}, 1)[0] == 0x17000);
+    REQUIRE(client.Call({IPC::MakeHeader(0x1B, 1, 0), 1}, 1)[0] == 0x17000);
+    // An out-of-range decoder type for the postprocessor is a parameter error.
+    REQUIRE(client.Call({IPC::MakeHeader(0x1B, 1, 0), 12}, 1)[0] == 0xE16170C9);
+    // MVC isn't supported by the hardware.
+    REQUIRE(client.Call({IPC::MakeHeader(0x6, 0, 0)}, 1)[0] == 0xD9617384);
+    // mvdstdExit: drain, then the release commands and Shutdown.
+    REQUIRE(client.NextPicture(true)[0] == 0x17000);
+    REQUIRE(client.Call({IPC::MakeHeader(0x1C, 0, 0)}, 1)[0] == 0x17000);
+    REQUIRE(client.Call({IPC::MakeHeader(0x19, 0, 0)}, 1)[0] == 0);
+    REQUIRE(client.Call({IPC::MakeHeader(0x7, 0, 0)}, 1)[0] == 0);
+    REQUIRE(client.Call({IPC::MakeHeader(0x2, 0, 0)}, 1)[0] == 0);
+}
