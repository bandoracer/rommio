+void MVD_STD::H264EnableMvc(Kernel::HLERequestContext& ctx) {
+    IPC::RequestParser rp(ctx);
+    // The MVD hardware has no MVC (stereoscopic H.264) support.
+    IPC::RequestBuilder rb = rp.MakeBuilder(1, 0);
+    rb.Push<u32>(ErrorUnsupported);
+}
