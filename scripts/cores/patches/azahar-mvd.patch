+u32 ValidateConfig(const PostprocessorConfig& config, bool combined) {
+    const u32 min_input_width = combined ? 48 : 16;
+    const u32 max_input = combined ? 8176 : 4096;
+    const u32 input_alignment = combined ? 8 : 16;
+
+    switch (config.input_format) {
+    case PixelFormat::YCbCr420Semiplanar:
+        break;
+    case PixelFormat::YCbCr420Tiled:
+    case PixelFormat::YCbCr400:
+        if (!combined) {
+            return Reject(ConfigError::InputFormat);
+        }
+        break;
+    case PixelFormat::YCbCr420Planar:
+        if (combined) {
+            return Reject(ConfigError::InputFormat);
+        }
+        break;
+    default:
+        if (combined || !IsPacked422(config.input_format)) {
+            return Reject(ConfigError::InputFormat);
+        }
+        break;
+    }
+    if (config.input_width < min_input_width || config.input_height < 16 ||
+        config.input_width > max_input || config.input_height > max_input ||
+        !IsAligned(config.input_width, input_alignment) ||
+        !IsAligned(config.input_height, input_alignment)) {
+        return Reject(ConfigError::InputSize);
+    }
+    if (!combined) {
+        const bool semiplanar = config.input_format == PixelFormat::YCbCr420Semiplanar;
+        const bool planar = config.input_format == PixelFormat::YCbCr420Planar;
+        if (!IsValidAddress(config.input_paddr) ||
+            ((semiplanar || planar) && !IsValidAddress(config.input_cb_paddr)) ||
+            (planar && !IsValidAddress(config.input_cr_paddr))) {
+            return Reject(ConfigError::InputAddress);
+        }
+    }
+    if (config.input_picture_structure > 5) {
+        return Reject(ConfigError::InputStructure);
+    }
+
+    u32 source_width = config.input_width;
+    u32 source_height = config.input_height;
+    if (config.crop_enable) {
+        if (!IsAligned(config.crop_x, 16) || !IsAligned(config.crop_y, 16) ||
+            !IsAligned(config.crop_width, 8) || !IsAligned(config.crop_height, 8) ||
+            config.crop_height < 16 || config.crop_width < min_input_width ||
+            config.crop_x + config.crop_width > config.input_width ||
+            config.crop_y + config.crop_height > config.input_height) {
+            return Reject(ConfigError::Crop);
+        }
+        source_width = config.crop_width;
+        source_height = config.crop_height;
+    }
+    if (config.rotation > 5) {
+        return Reject(ConfigError::Rotation);
+    }
+    if (config.rotation == 1 || config.rotation == 2) {
+        std::swap(source_width, source_height);
+    }
+
+    switch (config.output_format) {
+    case PixelFormat::YCbCr422Interleaved:
+    case PixelFormat::YCrYCb422Interleaved:
+    case PixelFormat::CbYCrY422Interleaved:
+    case PixelFormat::CrYCbY422Interleaved:
+    case PixelFormat::YCbCr420Semiplanar:
+    case PixelFormat::Rgb16Custom:
+    case PixelFormat::Rgb16_555:
+    case PixelFormat::Rgb16_565:
+    case PixelFormat::Bgr16_555:
+    case PixelFormat::Bgr16_565:
+    case PixelFormat::Rgb32Custom:
+    case PixelFormat::Rgb32:
+    case PixelFormat::Bgr32:
+        break;
+    default:
+        return Reject(ConfigError::OutputFormat);
+    }
+    if (config.output_width < 16 || config.output_width > 1920 || config.output_height < 16 ||
+        config.output_height > 4096) {
+        return Reject(ConfigError::OutputSize);
+    }
+    // Scaling: at most 3x up (3x - 2 for height), 1/70 down, and not up in one direction while
+    // down in the other.
+    const bool up_x = config.output_width > source_width;
+    const bool up_y = config.output_height > source_height;
+    const bool down_x = config.output_width < source_width;
+    const bool down_y = config.output_height < source_height;
+    if (config.output_width > 3 * source_width || config.output_height + 2 > 3 * source_height ||
+        config.output_width * 70 < source_width || config.output_height * 70 < source_height ||
+        (up_x && down_y) || (down_x && up_y)) {
+        return Reject(ConfigError::OutputSize);
+    }
+    if (!IsValidAddress(config.output_paddr) ||
+        (config.output_format == PixelFormat::YCbCr420Semiplanar &&
+         !IsValidAddress(config.output_chroma_paddr))) {
+        return Reject(ConfigError::OutputAddress);
+    }
+    if (IsRgb(config.output_format)) {
+        if (config.rgb_transform > 2 || config.contrast < -64 || config.contrast > 64 ||
+            config.brightness < -128 || config.brightness > 127 || config.saturation < -64 ||
+            config.saturation > 128) {
+            return Reject(ConfigError::ColorAdjustment);
+        }
+        if (config.output_format == PixelFormat::Rgb16Custom ||
+            config.output_format == PixelFormat::Rgb32Custom) {
+            const std::array<u32, 4> masks{config.mask_r, config.mask_g, config.mask_b,
+                                           config.mask_alpha};
+            u32 all = 0;
+            for (const u32 mask : masks) {
+                if (!IsContiguousMask(mask) || (all & mask) != 0 ||
+                    (config.output_format == PixelFormat::Rgb16Custom && mask > 0xFFFF)) {
+                    return Reject(ConfigError::RgbMasks);
+                }
+                all |= mask;
+            }
+        }
+    }
+    if (config.frame_buffer_enable) {
+        const bool nv12 = config.output_format == PixelFormat::YCbCr420Semiplanar;
+        const s64 x = config.frame_buffer_x, y = config.frame_buffer_y;
+        if (config.frame_buffer_width == 0 || config.frame_buffer_width > 4096 ||
+            config.frame_buffer_height == 0 || config.frame_buffer_height > 4096 ||
+            x >= config.frame_buffer_width || y >= config.frame_buffer_height ||
+            x + config.output_width <= 0 || y + config.output_height <= 0 ||
+            (nv12 && ((y & 1) != 0 || (config.frame_buffer_height & 1) != 0))) {
+            return Reject(ConfigError::FrameBuffer);
+        }
+    }
+    return 0;
+}
+
+OutputLayout GetOutputLayout(const PostprocessorConfig& config) {
+    OutputLayout layout;
+    layout.width = config.frame_buffer_enable ? config.frame_buffer_width : config.output_width;
+    layout.height = config.frame_buffer_enable ? config.frame_buffer_height : config.output_height;
+    if (config.output_format == PixelFormat::YCbCr420Semiplanar) {
+        layout.bytes_per_pixel = 1;
+        layout.plane_size = std::size_t{layout.width} * layout.height;
+        layout.chroma_size = std::size_t{layout.width} * ((layout.height + 1) / 2);
+        return layout;
+    }
+    layout.bytes_per_pixel = IsRgb32(config.output_format) ? 4 : 2;
+    layout.plane_size = std::size_t{layout.width} * layout.height * layout.bytes_per_pixel;
+    return layout;
+}
+
+void Postprocess(const SourceImage& source, const PostprocessorConfig& config,
+                 const OutputPlanes& output) {
+    if (source.width == 0 || source.height == 0) {
+        return;
+    }
+    if (config.contrast != 0) {
+        LOG_WARNING(Service_MVD, "Contrast adjustment ({}) is not emulated", config.contrast);
+    }
+    for (const u32 enable : {config.overlay1[0], config.overlay2[0], config.deinterlace}) {
+        if (enable) {
+            LOG_WARNING(Service_MVD, "Output masks and deinterlacing are not emulated");
+            break;
+        }
+    }
+
+    // The source rectangle, in the source image (which may be smaller than the configured input
+    // when the stream's crop window is all the decoder kept).
+    u32 crop_x = 0, crop_y = 0;
+    u32 crop_width = std::min(config.input_width, source.width);
+    u32 crop_height = std::min(config.input_height, source.height);
+    if (config.crop_enable) {
+        crop_x = std::min(config.crop_x, source.width - 1);
+        crop_y = std::min(config.crop_y, source.height - 1);
+        crop_width = std::min(config.crop_width, source.width - crop_x);
+        crop_height = std::min(config.crop_height, source.height - crop_y);
+    }
+    const bool transposed = config.rotation == 1 || config.rotation == 2;
+    const u32 rotated_width = transposed ? crop_height : crop_width;
+    const u32 rotated_height = transposed ? crop_width : crop_height;
+
+    // Maps a position in the rotated rectangle to the source image.
+    const auto unrotate = [&](float x, float y) -> std::pair<float, float> {
+        const float w = static_cast<float>(crop_width - 1), h = static_cast<float>(crop_height - 1);
+        float sx = x, sy = y;
+        switch (config.rotation) {
+        case 1: // 90 degrees right: the source's bottom-left lands top-left
+            sx = y, sy = h - x;
+            break;
+        case 2: // 90 degrees left
+            sx = w - y, sy = x;
+            break;
+        case 3: // horizontal flip
+            sx = w - x;
+            break;
+        case 4: // vertical flip
+            sy = h - y;
+            break;
+        case 5: // 180 degrees
+            sx = w - x, sy = h - y;
+            break;
+        default:
+            break;
+        }
+        return {sx + static_cast<float>(crop_x), sy + static_cast<float>(crop_y)};
+    };
+
+    const Sampler sampler(source);
+    const bool identity = config.rotation == 0 && rotated_width == config.output_width &&
+                          rotated_height == config.output_height;
+    const float scale_x =
+        static_cast<float>(rotated_width) / static_cast<float>(config.output_width);
+    const float scale_y =
+        static_cast<float>(rotated_height) / static_cast<float>(config.output_height);
+    const auto sample = [&](u32 ox, u32 oy) {
+        if (identity) {
+            return sampler.At(ox + crop_x, oy + crop_y);
+        }
+        const float rx = (static_cast<float>(ox) + 0.5f) * scale_x - 0.5f;
+        const float ry = (static_cast<float>(oy) + 0.5f) * scale_y - 0.5f;
+        const auto [sx, sy] = unrotate(std::max(rx, 0.0f), std::max(ry, 0.0f));
+        return sampler.Bilinear(sx, sy);
+    };
+
+    const OutputLayout layout = GetOutputLayout(config);
+    const s64 origin_x = config.frame_buffer_enable ? config.frame_buffer_x : 0;
+    const s64 origin_y = config.frame_buffer_enable ? config.frame_buffer_y : 0;
+    const ColorConverter converter(config);
+    const auto order = Packed422Order(config.output_format);
+    const u32 alpha = config.alpha & 0xFF;
+    const u16 transparency = config.transparency ? 0x8000 : 0;
+
+    if (IsPacked422(config.output_format)) {
+        // Pixel pairs of the surface share Cb and Cr, averaged over the pair's picture pixels.
+        for (u32 oy = 0; oy < config.output_height; ++oy) {
+            const s64 y = origin_y + oy;
+            if (y < 0 || y >= layout.height) {
+                continue;
+            }
+            for (s64 pair_x = (origin_x & ~s64{1}); pair_x < origin_x + config.output_width;
+                 pair_x += 2) {
+                if (pair_x < 0 || pair_x + 1 >= layout.width) {
+                    continue;
+                }
+                const std::size_t pair = (static_cast<std::size_t>(y) * layout.width + pair_x) * 2;
+                std::array<std::optional<YCbCr>, 2> pixels;
+                for (s64 i = 0; i < 2; ++i) {
+                    const s64 ox = pair_x + i - origin_x;
+                    if (ox >= 0 && ox < config.output_width) {
+                        pixels[i] = sample(static_cast<u32>(ox), oy);
+                    }
+                }
+                const YCbCr first = pixels[0].value_or(*pixels[1]);
+                const YCbCr second = pixels[1].value_or(*pixels[0]);
+                if (pixels[0]) {
+                    output.plane[pair + order[0]] = first.y;
+                }
+                if (pixels[1]) {
+                    output.plane[pair + order[2]] = second.y;
+                }
+                output.plane[pair + order[1]] = static_cast<u8>((first.cb + second.cb + 1) / 2);
+                output.plane[pair + order[3]] = static_cast<u8>((first.cr + second.cr + 1) / 2);
+            }
+        }
+        return;
+    }
+
+    for (u32 oy = 0; oy < config.output_height; ++oy) {
+        const s64 y = origin_y + oy;
+        if (y < 0 || y >= layout.height) {
+            continue;
+        }
+        for (u32 ox = 0; ox < config.output_width; ++ox) {
+            const s64 x = origin_x + ox;
+            if (x < 0 || x >= layout.width) {
+                continue;
+            }
+            const std::size_t pixel = static_cast<std::size_t>(y) * layout.width + x;
+            switch (config.output_format) {
+            case PixelFormat::YCbCr420Semiplanar: {
+                const YCbCr value = sample(ox, oy);
+                output.plane[pixel] = value.y;
+                if ((y & 1) == 0 && (x & 1) == 0) {
+                    const std::size_t c = static_cast<std::size_t>(y / 2) * layout.width + x;
+                    output.chroma[c] = value.cb;
+                    output.chroma[c + 1] = value.cr;
+                }
+                break;
+            }
+            default: {
+                const auto rgb = converter.ToRgb(sample(ox, oy));
+                const std::size_t offset = pixel * layout.bytes_per_pixel;
+                switch (config.output_format) {
+                case PixelFormat::Rgb16_565:
+                    Write16(
+                        output.plane, offset,
+                        static_cast<u16>((rgb[0] >> 3) << 11 | (rgb[1] >> 2) << 5 | rgb[2] >> 3));
+                    break;
+                case PixelFormat::Bgr16_565:
+                    Write16(
+                        output.plane, offset,
+                        static_cast<u16>((rgb[2] >> 3) << 11 | (rgb[1] >> 2) << 5 | rgb[0] >> 3));
+                    break;
+                case PixelFormat::Rgb16_555:
+                    Write16(output.plane, offset,
+                            static_cast<u16>(transparency | (rgb[0] >> 3) << 10 |
+                                             (rgb[1] >> 3) << 5 | rgb[2] >> 3));
+                    break;
+                case PixelFormat::Bgr16_555:
+                    Write16(output.plane, offset,
+                            static_cast<u16>(transparency | (rgb[2] >> 3) << 10 |
+                                             (rgb[1] >> 3) << 5 | rgb[0] >> 3));
+                    break;
+                case PixelFormat::Rgb16Custom:
+                    Write16(output.plane, offset,
+                            static_cast<u16>(PackMasked(rgb, config.mask_r, config.mask_g,
+                                                        config.mask_b, config.mask_alpha)));
+                    break;
+                case PixelFormat::Rgb32:
+                    Write32(output.plane, offset,
+                            alpha << 24 | u32{rgb[0]} << 16 | u32{rgb[1]} << 8 | rgb[2]);
+                    break;
+                case PixelFormat::Bgr32:
+                    Write32(output.plane, offset,
+                            alpha << 24 | u32{rgb[2]} << 16 | u32{rgb[1]} << 8 | rgb[0]);
+                    break;
+                case PixelFormat::Rgb32Custom:
+                    Write32(output.plane, offset,
+                            PackMasked(rgb, config.mask_r, config.mask_g, config.mask_b,
+                                       config.mask_alpha));
+                    break;
+                default:
+                    break;
+                }
+                break;
+            }
+            }
+        }
+    }
+}
+
+std::array<std::size_t, 3> StandaloneInputSizes(PixelFormat format, u32 width, u32 height) {
+    const std::size_t pixels = std::size_t{width} * height;
+    switch (format) {
+    case PixelFormat::YCbCr420Semiplanar:
+        return {pixels, pixels / 2, 0};
+    case PixelFormat::YCbCr420Planar:
+        return {pixels, pixels / 4, pixels / 4};
+    default:
+        return {IsPacked422(format) ? pixels * 2 : 0, 0, 0};
+    }
+}
+
+std::optional<StandaloneInput> LoadStandaloneInput(PixelFormat format, u32 width, u32 height,
+                                                   std::span<const u8> plane,
+                                                   std::span<const u8> cb, std::span<const u8> cr) {
+    const auto sizes = StandaloneInputSizes(format, width, height);
+    if (sizes[0] == 0 || plane.size() < sizes[0] || cb.size() < sizes[1] || cr.size() < sizes[2]) {
+        return std::nullopt;
+    }
+    StandaloneInput input;
+    input.image.width = width;
+    input.image.height = height;
+    input.image.luma_stride = width;
+    input.image.chroma_stride = (width + 1) / 2 * 2;
+    input.luma.resize(std::size_t{width} * height);
+
+    if (IsPacked422(format)) {
+        const auto order = Packed422Order(format);
+        input.image.chroma_full_height = true;
+        input.chroma.resize(std::size_t{input.image.chroma_stride} * height);
+        for (u32 y = 0; y < height; ++y) {
+            for (u32 x = 0; x < width; x += 2) {
+                const std::size_t pair = (std::size_t{y} * width + x) * 2;
+                input.luma[std::size_t{y} * width + x] = plane[pair + order[0]];
+                if (x + 1 < width) {
+                    input.luma[std::size_t{y} * width + x + 1] = plane[pair + order[2]];
+                }
+                const std::size_t c = std::size_t{y} * input.image.chroma_stride + x;
+                input.chroma[c] = plane[pair + order[1]];
+                input.chroma[c + 1] = plane[pair + order[3]];
+            }
+        }
+    } else {
+        std::copy_n(plane.begin(), input.luma.size(), input.luma.begin());
+        const std::size_t chroma_rows = (height + 1) / 2;
+        input.chroma.resize(std::size_t{input.image.chroma_stride} * chroma_rows);
+        if (format == PixelFormat::YCbCr420Semiplanar) {
+            std::copy_n(cb.begin(), std::min(cb.size(), input.chroma.size()), input.chroma.begin());
+        } else {
+            const u32 chroma_width = (width + 1) / 2;
+            for (std::size_t y = 0; y < chroma_rows; ++y) {
+                for (u32 x = 0; x < chroma_width; ++x) {
+                    const std::size_t c = y * input.image.chroma_stride + x * 2;
+                    input.chroma[c] = cb[y * chroma_width + x];
+                    input.chroma[c + 1] = cr[y * chroma_width + x];
+                }
+            }
+        }
+    }
+    // Moving the vectors into the result keeps their storage, so these views stay valid.
+    input.image.luma = input.luma;
+    input.image.chroma = input.chroma;
+    return input;
+}
+
+} // namespace Service::MVD
diff --git a/src/core/hle/service/mvd/postprocessor.h b/src/core/hle/service/mvd/postprocessor.h
new file mode 100644
index 0000000..d0cb2d7
--- /dev/null
+++ b/src/core/hle/service/mvd/postprocessor.h
@@ -0,0 +1,156 @@
+// Copyright 2026 Azahar Emulator Project
+// Licensed under GPLv2 or any later version
+// Refer to the license.txt file included.
+
+#pragma once
+
+#include <array>
+#include <cstddef>
+#include <optional>
+#include <span>
+#include <vector>
+#include <boost/serialization/binary_object.hpp>
+#include "common/common_types.h"
+
+namespace Service::MVD {
+
+/// Hantro postprocessor pixel formats (PP_PIX_FMT_*), used for both input and output.
+enum class PixelFormat : u32 {
+    YCbCr422Interleaved = 0x00010001, ///< Y0 Cb Y1 Cr (YUYV)
+    YCrYCb422Interleaved = 0x00010005,
+    CbYCrY422Interleaved = 0x00010006,
+    CrYCbY422Interleaved = 0x00010007,
+    YCbCr420Planar = 0x00020000,
+    YCbCr420Semiplanar = 0x00020001, ///< NV12, the decoder's native output
+    YCbCr420Tiled = 0x00020002,
+    YCbCr400 = 0x00080000, ///< Luma only
+    Rgb16Custom = 0x00040000,
+    Rgb16_555 = 0x00040001,
+    Rgb16_565 = 0x00040002, ///< R in bits 15..11; libctru calls this MVD_OUTPUT_BGR565
+    Bgr16_555 = 0x00040003,
+    Bgr16_565 = 0x00040004, ///< B in bits 15..11; libctru calls this MVD_OUTPUT_RGB565
+    Rgb32Custom = 0x00041000,
+    Rgb32 = 0x00041001,
+    Bgr32 = 0x00041002,
+};
+
+/// The 0x11C-byte configuration exchanged with GetConfig and SetConfig: Hantro's PPConfig.
+/// Addresses are physical.
+struct PostprocessorConfig {
+    PixelFormat input_format;
+    u32 input_picture_structure;
+    u32 input_full_range;
+    u32 input_width;
+    u32 input_height;
+    u32 input_paddr;
+    u32 input_cb_paddr;
+    u32 input_cr_paddr;
+    u32 input_bottom_paddr;
+    u32 input_bottom_chroma_paddr;
+    std::array<u32, 6> vc1;
+    u32 crop_enable;
+    u32 crop_x;
+    u32 crop_y;
+    u32 crop_height;
+    u32 crop_width;
+    u32 rotation;
+    PixelFormat output_format;
+    u32 output_width;
+    u32 output_height;
+    u32 output_paddr;
+    u32 output_chroma_paddr;
+    u32 rgb_transform; ///< 0 custom (coefficients below), 1 BT.601, 2 BT.709
+    s32 contrast;
+    s32 brightness;
+    s32 saturation;
+    u32 alpha;
+    u32 transparency;
+    std::array<u32, 5> coefficients; ///< a..e, 8.8 fixed point
+    u32 mask_r;
+    u32 mask_g;
+    u32 mask_b;
+    u32 mask_alpha;
+    u32 dithering;
+    std::array<u32, 11> overlay1;
+    std::array<u32, 11> overlay2;
+    u32 frame_buffer_enable;
+    s32 frame_buffer_x;
+    s32 frame_buffer_y;
+    u32 frame_buffer_width;
+    u32 frame_buffer_height;
+    u32 deinterlace;
+
+    template <class Archive>
+    void serialize(Archive& ar, const unsigned int) {
+        ar& boost::serialization::make_binary_object(this, sizeof(*this));
+    }
+};
+static_assert(sizeof(PostprocessorConfig) == 0x11C, "MVD configuration has the wrong size");
+static_assert(offsetof(PostprocessorConfig, crop_enable) == 0x40);
+static_assert(offsetof(PostprocessorConfig, output_format) == 0x58);
+static_assert(offsetof(PostprocessorConfig, output_paddr) == 0x64);
+static_assert(offsetof(PostprocessorConfig, rgb_transform) == 0x6C);
+static_assert(offsetof(PostprocessorConfig, coefficients) == 0x84);
+static_assert(offsetof(PostprocessorConfig, dithering) == 0xA8);
+static_assert(offsetof(PostprocessorConfig, overlay2) == 0xD8);
+static_assert(offsetof(PostprocessorConfig, frame_buffer_enable) == 0x104);
+
+/// An image the postprocessor reads: a luma plane and a plane of interleaved Cb/Cr samples at
+/// half the horizontal resolution and, for 4:2:0 (NV12), half the vertical resolution too.
+struct SourceImage {
+    u32 width = 0;
+    u32 height = 0;
+    std::span<const u8> luma;
+    u32 luma_stride = 0;
+    std::span<const u8> chroma;
+    u32 chroma_stride = 0;
+    bool chroma_full_height = false; ///< 4:2:2 rather than 4:2:0.
+    bool monochrome = false;
+};
+
+/// Where the postprocessor writes: the output plane (or packed image) and, for NV12 output,
+/// the chroma plane.
+struct OutputPlanes {
+    std::span<u8> plane;
+    std::span<u8> chroma;
+};
+
+/// The image layout the configuration writes.
+struct OutputLayout {
+    u32 width = 0; ///< Of the whole surface (the frame buffer, when enabled).
+    u32 height = 0;
+    u32 bytes_per_pixel = 0;
+    std::size_t plane_size = 0;
+    std::size_t chroma_size = 0; ///< Non-zero only for NV12 output.
+};
+
+/// The Hantro status a configuration is rejected with (as a 3DS result), or 0 when it is valid.
+/// `combined` is true when the postprocessor is attached to the decoder.
+u32 ValidateConfig(const PostprocessorConfig& config, bool combined);
+
+/// The surface a (valid) configuration writes.
+OutputLayout GetOutputLayout(const PostprocessorConfig& config);
+
+/// Crops, rotates and scales `source` and converts it to the output format, writing into
+/// `output`, which must be at least as large as GetOutputLayout reports.
+void Postprocess(const SourceImage& source, const PostprocessorConfig& config,
+                 const OutputPlanes& output);
+
+/// A standalone input converted into the planes a SourceImage reads.
+struct StandaloneInput {
+    std::vector<u8> luma;
+    std::vector<u8> chroma;
+    SourceImage image;
+};
+
+/// Reads a standalone color-conversion input (packed 4:2:2, planar or semiplanar 4:2:0) from
+/// its planes; std::nullopt for formats MVD can't take as standalone input.
+std::optional<StandaloneInput> LoadStandaloneInput(PixelFormat format, u32 width, u32 height,
+                                                   std::span<const u8> plane,
+                                                   std::span<const u8> cb, std::span<const u8> cr);
+
+/// Bytes a standalone input of this format occupies (luma or packed plane, and each chroma
+/// plane).
+std::array<std::size_t, 3> StandaloneInputSizes(PixelFormat format, u32 width, u32 height);
+
+} // namespace Service::MVD
