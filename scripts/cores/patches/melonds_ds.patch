+// Cartridge bytes and generated firmware's persistent WFC identity are one
+// complete portable save inventory. No native structs or pointers are persisted.
+size_t MelonDsDs::CoreState::RommioSaveSize() const noexcept {
+    if (!Console || Console->ConsoleType != 0 || _messageScreen || !_ndsInfo || _gbaInfo || !_ndsSaveManager ||
+        Console->GetFirmware().GetHeader().Identifier != melonDS::GENERATED_FIRMWARE_IDENTIFIER) return 0;
+    const auto& firmware = Console->GetFirmware();
+    static_assert(sizeof(firmware.GetExtendedAccessPoints()) + sizeof(firmware.GetAccessPoints()) == 2304);
+    return size_t(_ndsSaveManager->SramLength()) + 2308;
+}
+const char *MelonDsDs::CoreState::RommioDescriptor() const noexcept {
+    static char result[128];
+    if (!RommioSaveSize()) return "";
+    snprintf(result,sizeof(result),"rommio-cart-v1:melonds_ds:nds:%zu:0",RommioSaveSize());
+    return result;
+}
+void *MelonDsDs::CoreState::RommioSaveData() noexcept {
+    const size_t total = RommioSaveSize();
+    if (!total) return nullptr;
+    const auto size = _ndsSaveManager->SramLength();
+    _rommioSave.resize(total);
+    for (unsigned i=0;i<4;++i) _rommioSave[i] = size >> (i*8);
+    memcpy(_rommioSave.data()+4,_ndsSaveManager->Sram(),size);
+    memcpy(_rommioSave.data()+4+size,Console->GetFirmware().GetExtendedAccessPointPosition(),2304);
+    return _rommioSave.data();
+}
+bool MelonDsDs::CoreState::RommioMemoryRestored() noexcept {
+    if (!RommioSaveSize() || _rommioSave.size()!=RommioSaveSize()) return false;
+    uint32_t size=0; for(unsigned i=0;i<4;++i) size |= uint32_t(_rommioSave[i]) << (i*8);
+    if (size != _ndsSaveManager->SramLength()) return false;
+    memcpy(_ndsSaveManager->Sram(),_rommioSave.data()+4,size);
+    memcpy(Console->GetFirmware().GetExtendedAccessPointPosition(),_rommioSave.data()+4+size,2304);
+    _ndsSramInstalled = false;
+    InstallNdsSram();
+    return true;
+}
