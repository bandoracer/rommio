+static std::vector<uint8_t> rommio_files_buffer;
+static bool rommio_files_importing = false;
+static std::string rommio_progress_root() {
+    return FileUtil::GetUserPath(FileUtil::UserPath::UserDir) + "rommio-progress";
+}
+static void rommio_closed_game_handles() {}
+
+extern "C" RETRO_API const char* retro_rommio_persistence_descriptor() {
+    return "rommio-files-v1:azahar:3ds";
+}
+
+extern "C" RETRO_API bool retro_rommio_prepare_restore(size_t size) {
+    if (size < 12 || size > rommio_files::max_bytes ||
+        !DrainAsyncOperations(Core::System::GetInstance())) return false;
+    try {
+        rommio_files_buffer.assign(size, 0);
+        rommio_files_importing = true;
+        return true;
+    } catch (...) { return false; }
+}
+
+extern "C" RETRO_API bool retro_rommio_memory_restored() {
+    if (!rommio_files_importing || !emu_instance || !emu_instance->game_loaded) return false;
+    rommio_files_importing = false;
+    const std::string game_path = LibRetro::settings.file_path;
+    retro_unload_game();
+    const bool restored = rommio_files::restore(rommio_progress_root(), rommio_files_buffer,
+                                               &rommio_closed_game_handles);
+    const retro_game_info game{game_path.c_str(), nullptr, 0, nullptr};
+    const bool reloaded = retro_load_game(&game);
+    return restored && reloaded;
+}
+
 void* retro_get_memory_data(unsigned id) {
+    if (id == RETRO_MEMORY_SAVE_RAM)
+        return rommio_files_buffer.empty() ? nullptr : rommio_files_buffer.data();
     // Memory is exposed via RETRO_ENVIRONMENT_SET_MEMORY_MAPS instead,
     // using virtual addresses for stable cheat/achievement support.
     return NULL;
 }
 
 size_t retro_get_memory_size(unsigned id) {
+    if (id == RETRO_MEMORY_SAVE_RAM) {
+        if (!rommio_files_importing) {
+            try {
+                if (!DrainAsyncOperations(Core::System::GetInstance()) ||
+                    !FileSys::DiskFile::RommioFlushAll()) return SIZE_MAX;
+                rommio_files_buffer = rommio_files::capture(rommio_progress_root());
+            } catch (...) { return SIZE_MAX; }
+        }
+        return rommio_files_buffer.size();
+    }
     return 0;
 }
 
