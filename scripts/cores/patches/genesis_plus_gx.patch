+/* CD container: internal 8 KiB followed by the complete configured RAM cart.
+ * Cartridge SRAM/EEPROM has a stable full 64 KiB inventory, even when pristine.
+ * Flash boards and Mode 1 cartridge+CD require separate content qualification. */
+static int disk_count;
+static unsigned char rommio_cd_save[0x2000 + 0x80000];
+static size_t rommio_save_size(void) {
+   if (system_hw == SYSTEM_MCD)
+      return 0x2000 + (scd.cartridge.id ? scd.cartridge.mask + 1 : 0);
+   return sram.on ? sizeof(sram.sram) : 0;
+}
+RETRO_API const char *retro_rommio_persistence_descriptor(void) {
+   static char result[128];
+   const char *system = NULL;
+   switch (system_hw) {
+      case SYSTEM_MD: system = "genesis"; break;
+      case SYSTEM_SMS: case SYSTEM_SMS2: case SYSTEM_MARKIII: case SYSTEM_PBC: system = "sms"; break;
+      case SYSTEM_GG: case SYSTEM_GGMS: system = "gamegear"; break;
+      case SYSTEM_MCD:
+         if (disk_count > 1 || scd.cartridge.boot || (scd.cartridge.id && scd.cartridge.mask + 1 > 0x80000)) return "";
+         system = "segacd"; break;
+      default: return "";
+   }
+   if (sram.type >= FLASH_MEMORY) return "";
+   snprintf(result, sizeof(result), "rommio-cart-v1:genesis_plus_gx:%s:%zu:0", system, rommio_save_size());
+   return result;
+}
+RETRO_API bool retro_rommio_memory_restored(void) {
+   if (!retro_rommio_persistence_descriptor()[0]) return false;
+   if (system_hw == SYSTEM_MCD) {
+      memcpy(scd.bram, rommio_cd_save, 0x2000);
+      if (scd.cartridge.id) memcpy(scd.cartridge.area, rommio_cd_save + 0x2000, scd.cartridge.mask + 1);
+   }
+   return true;
 }
 
