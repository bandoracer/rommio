+/* Stable byte inventory: EEPROM, four controller paks, SRAM, flash and RTC.
+ * 64DD and Transfer Pak have additional media and are intentionally excluded. */
+
+static void rommio_put64(uint8_t *p, uint64_t v) { unsigned i; for (i=0;i<8;i++) p[i]=(uint8_t)(v>>(8*i)); }
+static uint64_t rommio_get64(const uint8_t *p) { unsigned i; uint64_t v=0; for(i=0;i<8;i++) v|=(uint64_t)p[i]<<(8*i); return v; }
+void rommio_restore_pending_clock(struct af_rtc *rtc) {
+   rommio_clock_ready = true;
+   if (rommio_clock_pending) {
+      rtc->control = rommio_clock[0] | ((uint16_t)rommio_clock[1] << 8);
+      rtc->now = (time_t)rommio_get64(rommio_clock+8);
+      rtc->last_update_rtc = (time_t)rommio_get64(rommio_clock+16);
+      rommio_clock_pending = false;
+   }
+}
+RETRO_API const char *retro_rommio_persistence_descriptor(void) {
+   if (!load_game_successful || retro_dd_path_img || retro_dd_path_rom || retro_transferpak_rom_path || retro_transferpak_ram_path) return "";
+   return "rommio-cart-v1:mupen64plus_next_gles3:n64:296960:24";
+}
+RETRO_API bool retro_rommio_memory_restored(void) {
+   unsigned i;
+   if (!retro_rommio_persistence_descriptor()[0] || sizeof(saved_memory) != 296960) return false;
+   for (i=2;i<8;i++) if (rommio_clock[i]) return false;
+   rommio_clock_pending = true;
+   if (rommio_clock_ready) rommio_restore_pending_clock(&g_dev.cart.af_rtc);
+   return true;
+}
